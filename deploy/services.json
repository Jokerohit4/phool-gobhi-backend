{
  "project": "phool-gobhi",
  "region": "asia-south1",
  "services": {
    "gateway": {
      "cloudRunServiceBaseName": "gateway",
      "sourceDir": ".",
      "hasPrisma": false,
      "healthCheckGuard": false,
      "allowUnauthenticated": true,
      "pathTriggers": [
        "index.js",
        "package.json",
        "package-lock.json",
        "Dockerfile",
        ".gcloudignore"
      ],
      "env": {
        "dev": {
          "plain": {
            "NODE_ENV": "development",
            "ANALYTICS_PROVIDER": "postgres",
            "ANALYTICS_SERVICE_NAME": "gateway",
            "AUTH_SERVICE_URL": "https://auth-service-dev-pwixdiy6va-el.a.run.app",
            "WALLET_SERVICE_URL": "https://wallet-service-dev-pwixdiy6va-el.a.run.app",
            "GYM_SERVICE_URL": "https://gym-service-dev-pwixdiy6va-el.a.run.app",
            "BOOKING_SERVICE_URL": "https://booking-service-dev-pwixdiy6va-el.a.run.app",
            "BUDDY_SERVICE_URL": "https://buddy-service-dev-pwixdiy6va-el.a.run.app",
            "CHALLENGE_SERVICE_URL": "https://challenge-service-dev-pwixdiy6va-el.a.run.app"
          },
          "secrets": {
            "JWT_SECRET": "jwt-secret",
            "ANALYTICS_DATABASE_URL": "db-url"
          }
        },
        "prod": {
          "plain": {
            "NODE_ENV": "production",
            "ANALYTICS_PROVIDER": "postgres",
            "ANALYTICS_SERVICE_NAME": "gateway",
            "AUTH_SERVICE_URL": "https://auth-service-prod-pwixdiy6va-el.a.run.app",
            "WALLET_SERVICE_URL": "https://wallet-service-prod-pwixdiy6va-el.a.run.app",
            "GYM_SERVICE_URL": "https://gym-service-prod-pwixdiy6va-el.a.run.app",
            "BOOKING_SERVICE_URL": "https://booking-service-prod-pwixdiy6va-el.a.run.app",
            "BUDDY_SERVICE_URL": "https://buddy-service-prod-pwixdiy6va-el.a.run.app",
            "CHALLENGE_SERVICE_URL": "https://challenge-service-prod-pwixdiy6va-el.a.run.app"
          },
          "secrets": {
            "JWT_SECRET": "jwt-secret",
            "ANALYTICS_DATABASE_URL": "analytics-database-url"
          }
        }
      }
    },

    "auth-service": {
      "cloudRunServiceBaseName": "auth-service",
      "sourceDir": "services/auth-service",
      "hasPrisma": true,
      "healthCheckGuard": false,
      "allowUnauthenticated": false,
      "pathTriggers": ["services/auth-service/**"],
      "env": {
        "dev": {
          "plain": {
            "NODE_ENV": "development",
            "ALLOW_DEV_OTP": "true",
            "ANALYTICS_PROVIDER": "postgres",
            "ANALYTICS_SERVICE_NAME": "auth-service",
            "OTP_PROVIDER": "firebase",
            "GYM_SERVICE_URL": "https://gym-service-dev-pwixdiy6va-el.a.run.app",
            "BUDDY_SERVICE_URL": "https://buddy-service-dev-pwixdiy6va-el.a.run.app",
            "WALLET_SERVICE_URL": "https://wallet-service-dev-pwixdiy6va-el.a.run.app"
          },
          "secrets": {
            "DATABASE_URL": "db-url",
            "ANALYTICS_DATABASE_URL": "db-url",
            "INTERNAL_API_KEY": "internal-api-key",
            "JWT_SECRET": "jwt-secret",
            "JWT_REFRESH_SECRET": "jwt-refresh-secret",
            "FAST2SMS_API_KEY": "fast2sms-api-key",
            "FIREBASE_SERVICE_ACCOUNT_JSON": "firebase-auth",
            "CLOUDINARY_CLOUD_NAME": "cloudinary-cloud-name",
            "CLOUDINARY_API_KEY": "cloudinary-api-key",
            "CLOUDINARY_API_SECRET": "cloudinary-api-secret"
          }
        },
        "prod": {
          "plain": {
            "NODE_ENV": "production",
            "ALLOW_DEV_OTP": "false",
            "ANALYTICS_PROVIDER": "postgres",
            "ANALYTICS_SERVICE_NAME": "auth-service",
            "OTP_PROVIDER": "firebase",
            "GYM_SERVICE_URL": "https://gym-service-prod-pwixdiy6va-el.a.run.app",
            "BUDDY_SERVICE_URL": "https://buddy-service-prod-pwixdiy6va-el.a.run.app",
            "WALLET_SERVICE_URL": "https://wallet-service-prod-pwixdiy6va-el.a.run.app"
          },
          "secrets": {
            "DATABASE_URL": "db-url",
            "ANALYTICS_DATABASE_URL": "analytics-database-url",
            "INTERNAL_API_KEY": "internal-api-key",
            "JWT_SECRET": "jwt-secret",
            "JWT_REFRESH_SECRET": "jwt-refresh-secret",
            "FAST2SMS_API_KEY": "fast2sms-api-key",
            "FIREBASE_SERVICE_ACCOUNT_JSON": "firebase-auth",
            "CLOUDINARY_CLOUD_NAME": "cloudinary-cloud-name",
            "CLOUDINARY_API_KEY": "cloudinary-api-key",
            "CLOUDINARY_API_SECRET": "cloudinary-api-secret"
          }
        }
      }
