generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["wallet"]
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  userType     String
  balance      Decimal             @default(0) @db.Decimal(19, 2)
  currency     String              @default("INR")
  status       WalletStatus        @default(active)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  transactions WalletTransaction[]

  @@schema("wallet")
}

enum WalletStatus {
  active
  frozen
  closed

  @@schema("wallet")
}

model WalletTransaction {
  id                Int               @id @default(autoincrement())
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  walletId          Int
  type              TransactionType
  amount            Decimal           @db.Decimal(19, 2)
  currency          String            @default("INR")
  status            TransactionStatus @default(success)
  description       String?
  razorpayOrderId   String?           @unique
  razorpayPaymentId String?           @unique
  // Lets a caller (e.g. booking-service's wallet debit for a reservation)
  // safely retry/reconcile the exact same operation without double-applying
  // it — the caller passes a deterministic key (e.g. "booking-debit-<id>"),
  // and creditWalletService/debitWalletService treat a second call with the
  // same key as a no-op, returning the wallet state unchanged.
  idempotencyKey    String?           @unique
  createdAt         DateTime          @default(now())
  // Which gym a credit/debit is attributable to — a partner with multiple
  // gyms otherwise has no way to tell which gym earned a given credit from
  // transaction history alone. Nullable: existing rows predate this column,
  // and not every transaction type (top-ups, manual payouts) has a gym.
  gymId             Int?

  @@index([gymId])
  @@schema("wallet")
}

enum TransactionType {
  credit
  debit
  transfer
  bonus
  payout
  topup
  withdrawal

  @@schema("wallet")
}

enum TransactionStatus {
  pending
  success
  failed
  reversed

  @@schema("wallet")
}

model RazorpayOrder {
  id                Int      @id @default(autoincrement())
  userId            Int
  orderId           String   @unique
  amount            Decimal  @db.Decimal(19, 2)
  status            String
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // "topup" (default, existing behavior) | "subscription" — lets /verify and
  // the webhook branch to the right fulfillment logic while reusing the same
  // claim-then-credit idempotency machinery for both purposes.
  purpose           String   @default("topup")
  gymId             Int?
  planType          String?

  @@index([status, createdAt])
  @@index([userId, status])
  @@schema("wallet")
}

model GymSubscription {
  id              Int                @id @default(autoincrement())
  customerId      Int
  gymId           Int
  partnerId       Int
  planType        String
  price           Decimal            @db.Decimal(19, 2)
  commissionPct   Decimal            @db.Decimal(5, 2)
  partnerShare    Decimal            @db.Decimal(19, 2)
  startDate       DateTime
  endDate         DateTime
  status          SubscriptionStatus @default(active)
  razorpayOrderId String             @unique
  createdAt       DateTime           @default(now())
  // "upfront" (legacy — partner already paid partnerShare in full at
  // purchase, see purchaseSubscriptionWithWallet's git history) | "perVisit"
  // (current — partner is credited partnerShare/days per completed booking,
  // see bookingCommissionFields in booking-service). Existing rows are
  // backfilled to "upfront" by this field's migration so bookingCommissionFields
  // never double-pays a partner who was already paid in full under the old
  // model — new rows default to "perVisit".
  payoutModel     String             @default("perVisit")
  // Attendance-based retention mechanic, computed once by
  // closeOutSubscriptionIfLapsed the first time this row is read after
  // endDate passes (closedOutAt marks that this has already run — every
  // field below is meaningless/zero until then). giftDaysGranted is capped
  // by both the plan's tier cap and the customer's actual missed-day count,
  // so it's always funded from this subscription's own already-collected
  // partnerShare, never a net cost. giftDaysRedeemed tracks how many of
  // those grace visits have actually been used (see redeemGiftDayService),
  // redeemable even though endDate has passed.
  giftDaysGranted  Int      @default(0)
  giftDaysRedeemed Int      @default(0)
  bonusPaid        Boolean  @default(false)
  closedOutAt      DateTime?
  // Set once the customer has actually seen the /gift-reveal screen for this
  // closed-out subscription — without it, hasUnseenGiftReveal (client-side)
  // stays true forever with nothing to ever flip it back, so the gift-box FAB
  // and reveal screen resurface on every app launch indefinitely.
  giftRevealSeenAt DateTime?

  @@index([customerId, gymId, status])
  @@schema("wallet")
}

enum SubscriptionStatus {
  active
  cancelled

  @@schema("wallet")
}
