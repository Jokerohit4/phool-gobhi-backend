generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?    @unique
  email     String?    @unique
  password  String?
  role      Role
  type      UserType
  gobhiType GobhiType?
  isActive  Boolean    @default(true)
  gender        Gender?
  dateOfBirth   DateTime?     @db.Date
  fitnessGoals  FitnessGoal[]
  profileImageUrl String    @default("")
  fcmToken        String    @default("")
  savedAddresses  SavedAddress[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@schema("auth")
}

model PitchAccessContact {
  id        Int              @id @default(autoincrement())
  type      PitchContactType
  value     String
  note      String?
  createdAt DateTime         @default(now())

  @@unique([type, value])
  @@schema("auth")
}

// Website /contact form submissions (first-party — replaces the previous
// Formspree integration, whose form id had gone stale/404 with no visible
// failure to the submitter). Read-only for staff via the admin portal.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("auth")
}

enum PitchContactType {
  email
  phone

  @@schema("auth")
}

model SavedAddress {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String
  formattedAddress String
  lat              Float
  lng              Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("auth")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  sentAt    DateTime

  @@schema("auth")
}

enum GobhiType {
  trainer
  cleaner
  manager

  @@schema("auth")
}

enum Role {
  customer
  partner
  gobhi

  @@schema("auth")
}

enum UserType {
  general
  sub_premium
  premium

  @@schema("auth")
}

enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@schema("auth")
}

enum FitnessGoal {
  weight_loss
  muscle_gain
  general_fitness
  flexibility_yoga
  sports_training
  rehabilitation

  @@schema("auth")
}