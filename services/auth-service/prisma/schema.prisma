generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String?
  phone     String?    @unique
  email     String?    @unique
  password  String?
  role      Role
  type      UserType
  gobhiType GobhiType?
  isActive  Boolean    @default(true)
  gender        Gender?
  dateOfBirth   DateTime?     @db.Date
  fitnessGoals  FitnessGoal[]
  // Collected at onboarding alongside gender/dateOfBirth/fitnessGoals — feeds
  // the customer app's client-side gym recommendation scorer (experienceLevel
  // is the highest-weighted, required field there) and gates the trainer
  // WhatsApp-handoff CTA to new/restarting users only.
  experienceLevel       ExperienceLevel?
  weeklyFrequencyIntent FrequencyIntent?
  // --- Onboarding branch (2026-09-18) -------------------------------------
  // Who this user is, decided once at onboarding and revisable later. These
  // live here rather than in health-service because the app must branch its
  // Home tab on them at boot, from the same /me call that already carries
  // linkedGymId — anything read only from health-service is unreachable
  // whenever the healthMetrics flag is off, which would be the wrong
  // dependency for tab routing.
  //
  // "Do you work out?" — null means never asked (pre-existing accounts, or
  // onboarding completed before this shipped), which is NOT the same as false.
  currentlyWorksOut Boolean?
  // Answers both phrasings of the same question ("where do you work out" for
  // an existing exerciser, "where would you prefer" for someone starting) —
  // one column, because the downstream behaviour is identical either way.
  trainingLocationPref TrainingLocationPref?
  // Free text behind the "Other" option. Deliberately unconstrained and never
  // parsed — it exists to be read by a human deciding what the next enum
  // value should be.
  trainingLocationOther String?
  // The derived, mutable field the app's Home tab branches on. Derivation
  // lives in authService (deriveAppMode) rather than being trusted from the
  // client, so the rule stays in one place when it changes.
  appMode AppMode?
  // Coarse "when are you usually free" bucket. Consumed for nudge send-time
  // and off-peak targeting — NOT collected for its own sake. If that consumer
  // ever goes away, delete the field rather than leaving it to rot the way
  // fitnessGoals did.
  freeTimeWindow FreeTimeWindow?
  profileImageUrl String    @default("")
  fcmToken        String    @default("")
  savedAddresses  SavedAddress[]
  refreshTokens   RefreshToken[]
  bankAccount     PartnerBankAccount?
  // Referral program: referralCode is this user's own shareable code,
  // deterministically derived from `id` right after creation (see
  // issueSessionForUser) — never random, so no collision-retry loop needed.
  // referredByUserId is set once at creation from an incoming code and never
  // mutated after; self-referral is structurally impossible since a user
  // can't know their own code before the row (and therefore the id it's
  // derived from) exists.
  referralCode     String?  @unique
  referredByUserId Int?
  referredBy       User?    @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals        User[]   @relation("Referrals")
  // Attendance-SaaS wedge: set once at account creation when signup
  // originated from a gym-specific "join us" QR/link (website /join/:gymId,
  // app phoolgobhi://join?gymId=), never mutated after — same contract as
  // referredByUserId. A bare Int, not a Prisma relation: Gym lives in
  // gym-service's own database, so this is an unenforced cross-service
  // reference, not a real foreign key. Drives the customer app's decision to
  // show a gym-scoped "linked member" home instead of the marketplace browse
  // home (see /api/auth/me).
  linkedGymId Int?
  // Which gym employs this trainer — set once at account creation by the
  // employing partner (see createTrainerService), never mutated after.
  // Meaningless for every other role. Same "bare Int, unenforced
  // cross-service reference" convention as linkedGymId above — Gym lives in
  // gym-service's own database, not this one.
  trainerGymId Int?
  // Set once the attendance-SaaS re-engagement sweep has resolved this
  // gym-linked user — either it sent them a nudge, or found them already
  // active (a completed booking or subscription purchase) and no nudge was
  // needed. Never reset either way, so a resolved user is never re-checked
  // on a later sweep run — this is "processed," not strictly "was nudged."
  reengagementNudgedAt DateTime?
  // Per-gym attendance leaderboards (booking-service, MemberAttendance-backed)
  // are on by default — a check-in is public on the boards it would rank on.
  // True by default; opt-out by the user, from the customer app's profile
  // screen only. Global, not per-gym: someone who stays on is visible on every
  // gym's board their check-ins would rank on.
  leaderboardOptIn Boolean @default(true)
  // Map collectibles (veggie pickups) are a standalone currency, deliberately
  // NOT coins and NOT tied to gyms/bookings/badges in any way -- just walk
  // near a spawn point on the Explore map and it's yours. Spawn points are
  // deterministic client-side (fixed grid, no catalog table needed); this
  // relation is only "which ones has this user found."
  collectibleFinds CollectibleFind[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Covers the attendance-SaaS monthly-bill query (users joined a gym in a
  // given month): where linkedGymId = X AND createdAt in [monthStart, monthEnd).
  @@index([linkedGymId, createdAt])
  @@schema("auth")
}

// One row per veggie collectible a user has picked up on the Explore map.
// collectibleId is a client-generated deterministic id (grid cell reference,
// e.g. "veg_12_7") -- there's no server-side spawn catalog, so this table is
// purely "has this user found this id," nothing more.
model CollectibleFind {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  collectibleId String
  foundAt       DateTime @default(now())

  @@unique([userId, collectibleId])
  @@schema("auth")
}

// Refresh-token rotation: one row per issued refresh token, chained via
// familyId. A row's usedAt/replacedByJti gets set the moment it's rotated;
// presenting an already-used token again after the grace window (see
// refreshTokenService.js) revokes the whole family — that's the theft-replay
// signal rotation exists to catch. expiresAt is fixed per family (not
// extended on rotation) so total session length stays the 7 days it is today.
model RefreshToken {
  id            String    @id @default(uuid())
  jti           String    @unique
  familyId      String
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  replacedByJti String?
  revokedAt     DateTime?

  @@index([familyId])
  @@index([userId])
  @@schema("auth")
}

model PitchAccessContact {
  id        Int              @id @default(autoincrement())
  type      PitchContactType
  value     String
  note      String?
  createdAt DateTime         @default(now())

  @@unique([type, value])
  @@schema("auth")
}

// Website /contact form submissions (first-party — replaces the previous
// Formspree integration, whose form id had gone stale/404 with no visible
// failure to the submitter). Read-only for staff via the admin portal.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("auth")
}

enum PitchContactType {
  email
  phone

  @@schema("auth")
}

// Website /careers listings — staff-managed via the admin portal's Jobs page,
// publicly readable (active only) at GET /api/auth/jobs.
model JobOpening {
  id             Int            @id @default(autoincrement())
  title          String
  department     String
  location       String
  employmentType EmploymentType
  description    String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@schema("auth")
}

enum EmploymentType {
  full_time
  part_time
  internship
  contract

  @@schema("auth")
}

// Applications submitted against a JobOpening (first-party — same rationale
// as ContactMessage: a mailto "Apply" link fails silently when the visitor
// has no default mail client). jobOpeningId/jobTitle are a plain snapshot,
// not a relation — an application stays reviewable even if the listing it
// was made against is later closed or deleted.
model JobApplication {
  id           Int      @id @default(autoincrement())
  jobOpeningId Int
  jobTitle     String
  name         String
  email        String
  phone        String
  portfolioUrl String?
  linkedinUrl  String?
  message      String
  resumePath   String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@schema("auth")
}

model SavedAddress {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String
  formattedAddress String
  lat              Float
  lng              Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("auth")
}

// A partner's bank details for the attendance-SaaS bank-settlement flow
// (wallet-service's PartnerBankSettlement) — admin uses this to actually
// make the manual bank transfer; there's no automated disbursement API
// here, this is just where the destination details are recorded.
// SECURITY NOTE: stored as plain columns, not encrypted at rest — same
// posture as the rest of this schema (no field-level encryption anywhere
// yet), flagged here explicitly since this is more sensitive than most of
// what's on User. Worth a follow-up if this needs to satisfy a stricter
// bar before real payout volume flows through it.
model PartnerBankAccount {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  accountHolderName String
  accountNumber     String
  ifscCode          String
  upiId             String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@schema("auth")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  sentAt    DateTime
  // Failed-verify counter for this live code — lets verifyOtpService lock
  // out further guesses once exceeded, closing a per-phone brute-force gap
  // that was previously only bounded by the gateway's per-IP rate limit.
  attempts  Int      @default(0)

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable min/latest app
// versions per app (customer/partner) + platform (android/ios), read by
// GET /api/auth/app-config so both Flutter apps can force- or soft-update
// on startup without a redeploy. Same pattern as booking-service's
// CancellationPolicySetting.
model AppVersionSetting {
  id        Int      @id @default(1)
  config    Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Platform-wide reviews ("What users say about us" on the website's
// /testimonials page) — distinct from gym-service's per-gym GymReview. One
// row per customer (upsert on customerId): resubmitting edits their existing
// review instead of piling up duplicates, and resets isApproved since an
// edited review hasn't been vetted yet. Starts unapproved — an admin must
// approve it (GET/PATCH/DELETE /api/auth/admin/platform-reviews) before it
// shows publicly.
model PlatformReview {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable launch gate for the
// website: `enabled=false` means always live (gate off); `enabled=true` with
// `launchAt` null means gated indefinitely (manual hold, no schedule set);
// `enabled=true` with `launchAt` set means gated until that instant. Read by
// public GET /api/auth/launch-status, which the website's proxy.ts uses to
// block gym visibility/booking creation pre-launch while partner onboarding
// (a separate route tree) stays open throughout.
model LaunchGateSetting {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  launchAt  DateTime?
  updatedAt DateTime  @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable OTP verification mode:
// fast2sms/firebase are the two real providers (unchanged behavior); skip
// layers a 123456 bypass onto the fast2sms code path but only for phones on
// OtpSkipAllowlistEntry — every other phone still gets/needs a real OTP even
// while skip is selected. Defaults to "firebase" until a row exists (the old
// OTP_PROVIDER env fallback was removed — fast2sms is only active when an
// admin explicitly picks it). Read by public GET /api/auth/otp-config (both
// Flutter apps and the website) and edited via GET/PUT /api/auth/otp-config/admin.
model OtpProviderSetting {
  id        Int      @id @default(1)
  provider  String   @default("firebase")
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Phone numbers allowed to bypass real OTP verification with 123456 while
// OtpProviderSetting.provider === "skip". Empty allowlist = skip mode
// bypasses nothing for anyone (fail-safe default) — deliberately mirrors
// PitchAccessContact's shape/normalization convention.
model OtpSkipAllowlistEntry {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable wallet bonus amount (₹)
// credited once when a customer's profile crosses from incomplete to complete.
// Defaults to 20 until a row exists (see profileCompletionBonusService.js);
// 0 disables the bonus entirely. Read by auth-service when crediting and by
// GET /api/auth/app-config so the customer app can display the real amount.
model ProfileCompletionBonusSetting {
  id        Int      @id @default(1)
  amount    Int
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

enum GobhiType {
  trainer
  cleaner
  manager

  @@schema("auth")
}

enum Role {
  customer
  partner
  gobhi
  // A gym's own personal trainer — see ROLES.TRAINER in userEnums.js for the
  // full distinction from GobhiType's trainer job-title label.
  trainer

  @@schema("auth")
}

enum UserType {
  general
  sub_premium
  premium

  @@schema("auth")
}

enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@schema("auth")
}

enum FitnessGoal {
  weight_loss
  muscle_gain
  general_fitness
  flexibility_yoga
  sports_training
  rehabilitation

  @@schema("auth")
}

enum ExperienceLevel {
  new_to_gym
  restarting_after_break
  experienced

  @@schema("auth")
}

enum FrequencyIntent {
  one_two
  three_four
  five_plus

  @@schema("auth")
}

// Where the user trains, or would prefer to. `gym` and `fitness_centre` are
// kept distinct because the whiteboard flow asks for them separately and the
// distinction is meaningful to users even though today they route the same —
// collapsing them now would be a lossy migration to undo later.
enum TrainingLocationPref {
  home
  gym
  fitness_centre
  other

  @@schema("auth")
}

// Which experience the app leads with.
//   gym_seeker — booking/PAYG is the proposition; Home leads with discovery.
//   home_track — the user already trains; the app is a workout/progress/habit
//                tool and PAYG is demoted to a single "try a gym" card.
// Two values, not four: this drives one branch, and every extra value here is
// another Home variant somebody has to build and maintain.
enum AppMode {
  gym_seeker
  home_track

  @@schema("auth")
}

enum FreeTimeWindow {
  morning
  afternoon
  evening
  late_night
  flexible

  @@schema("auth")
}
// Every time a user switches which experience the app leads with.
//
// Append-only, and the reason it exists is measurement rather than
// correctness: the onboarding branch is a guess about how people split, and
// this is how you find out whether the guess was right. If users switch once
// and stay, the split was good; if they oscillate, the question was wrong.
//
// Also the audit trail for a field that changes what a user sees — without
// it, "why does my app look different" has no answer.
model AppModeHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  // Null on the first row for a user: they came from onboarding, not from
  // switching away from something.
  fromMode  AppMode?
  toMode    AppMode
  // 'onboarding' | 'floating_prompt' | 'settings'
  source    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@schema("auth")
}
