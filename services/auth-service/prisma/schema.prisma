generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String?
  phone     String?    @unique
  email     String?    @unique
  password  String?
  role      Role
  type      UserType
  gobhiType GobhiType?
  isActive  Boolean    @default(true)
  gender        Gender?
  dateOfBirth   DateTime?     @db.Date
  fitnessGoals  FitnessGoal[]
  // Collected at onboarding alongside gender/dateOfBirth/fitnessGoals — feeds
  // the customer app's client-side gym recommendation scorer (experienceLevel
  // is the highest-weighted, required field there) and gates the trainer
  // WhatsApp-handoff CTA to new/restarting users only.
  experienceLevel       ExperienceLevel?
  weeklyFrequencyIntent FrequencyIntent?
  profileImageUrl String    @default("")
  fcmToken        String    @default("")
  savedAddresses  SavedAddress[]
  refreshTokens   RefreshToken[]
  // Referral program: referralCode is this user's own shareable code,
  // deterministically derived from `id` right after creation (see
  // issueSessionForUser) — never random, so no collision-retry loop needed.
  // referredByUserId is set once at creation from an incoming code and never
  // mutated after; self-referral is structurally impossible since a user
  // can't know their own code before the row (and therefore the id it's
  // derived from) exists.
  referralCode     String?  @unique
  referredByUserId Int?
  referredBy       User?    @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals        User[]   @relation("Referrals")
  // Attendance-SaaS wedge: set once at account creation when signup
  // originated from a gym-specific "join us" QR/link (website /join/:gymId,
  // app phoolgobhi://join?gymId=), never mutated after — same contract as
  // referredByUserId. A bare Int, not a Prisma relation: Gym lives in
  // gym-service's own database, so this is an unenforced cross-service
  // reference, not a real foreign key. Drives the customer app's decision to
  // show a gym-scoped "linked member" home instead of the marketplace browse
  // home (see /api/auth/me).
  linkedGymId Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@schema("auth")
}

// Refresh-token rotation: one row per issued refresh token, chained via
// familyId. A row's usedAt/replacedByJti gets set the moment it's rotated;
// presenting an already-used token again after the grace window (see
// refreshTokenService.js) revokes the whole family — that's the theft-replay
// signal rotation exists to catch. expiresAt is fixed per family (not
// extended on rotation) so total session length stays the 7 days it is today.
model RefreshToken {
  id            String    @id @default(uuid())
  jti           String    @unique
  familyId      String
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  replacedByJti String?
  revokedAt     DateTime?

  @@index([familyId])
  @@index([userId])
  @@schema("auth")
}

model PitchAccessContact {
  id        Int              @id @default(autoincrement())
  type      PitchContactType
  value     String
  note      String?
  createdAt DateTime         @default(now())

  @@unique([type, value])
  @@schema("auth")
}

// Website /contact form submissions (first-party — replaces the previous
// Formspree integration, whose form id had gone stale/404 with no visible
// failure to the submitter). Read-only for staff via the admin portal.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("auth")
}

enum PitchContactType {
  email
  phone

  @@schema("auth")
}

// Website /careers listings — staff-managed via the admin portal's Jobs page,
// publicly readable (active only) at GET /api/auth/jobs.
model JobOpening {
  id             Int            @id @default(autoincrement())
  title          String
  department     String
  location       String
  employmentType EmploymentType
  description    String
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@schema("auth")
}

enum EmploymentType {
  full_time
  part_time
  internship
  contract

  @@schema("auth")
}

// Applications submitted against a JobOpening (first-party — same rationale
// as ContactMessage: a mailto "Apply" link fails silently when the visitor
// has no default mail client). jobOpeningId/jobTitle are a plain snapshot,
// not a relation — an application stays reviewable even if the listing it
// was made against is later closed or deleted.
model JobApplication {
  id           Int      @id @default(autoincrement())
  jobOpeningId Int
  jobTitle     String
  name         String
  email        String
  phone        String
  portfolioUrl String?
  linkedinUrl  String?
  message      String
  resumePath   String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@schema("auth")
}

model SavedAddress {
  id               Int      @id @default(autoincrement())
  userId           Int
  label            String
  formattedAddress String
  lat              Float
  lng              Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("auth")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  sentAt    DateTime
  // Failed-verify counter for this live code — lets verifyOtpService lock
  // out further guesses once exceeded, closing a per-phone brute-force gap
  // that was previously only bounded by the gateway's per-IP rate limit.
  attempts  Int      @default(0)

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable min/latest app
// versions per app (customer/partner) + platform (android/ios), read by
// GET /api/auth/app-config so both Flutter apps can force- or soft-update
// on startup without a redeploy. Same pattern as booking-service's
// CancellationPolicySetting.
model AppVersionSetting {
  id        Int      @id @default(1)
  config    Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Platform-wide reviews ("What users say about us" on the website's
// /testimonials page) — distinct from gym-service's per-gym GymReview. One
// row per customer (upsert on customerId): resubmitting edits their existing
// review instead of piling up duplicates, and resets isApproved since an
// edited review hasn't been vetted yet. Starts unapproved — an admin must
// approve it (GET/PATCH/DELETE /api/auth/admin/platform-reviews) before it
// shows publicly.
model PlatformReview {
  id         Int      @id @default(autoincrement())
  customerId Int      @unique
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable launch gate for the
// website: `enabled=false` means always live (gate off); `enabled=true` with
// `launchAt` null means gated indefinitely (manual hold, no schedule set);
// `enabled=true` with `launchAt` set means gated until that instant. Read by
// public GET /api/auth/launch-status, which the website's proxy.ts uses to
// block gym visibility/booking creation pre-launch while partner onboarding
// (a separate route tree) stays open throughout.
model LaunchGateSetting {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  launchAt  DateTime?
  updatedAt DateTime  @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable OTP verification mode:
// fast2sms/firebase are the two real providers (unchanged behavior); skip
// layers a 123456 bypass onto the fast2sms code path but only for phones on
// OtpSkipAllowlistEntry — every other phone still gets/needs a real OTP even
// while skip is selected. Defaults to "firebase" until a row exists (the old
// OTP_PROVIDER env fallback was removed — fast2sms is only active when an
// admin explicitly picks it). Read by public GET /api/auth/otp-config (both
// Flutter apps and the website) and edited via GET/PUT /api/auth/otp-config/admin.
model OtpProviderSetting {
  id        Int      @id @default(1)
  provider  String   @default("firebase")
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

// Phone numbers allowed to bypass real OTP verification with 123456 while
// OtpProviderSetting.provider === "skip". Empty allowlist = skip mode
// bypasses nothing for anyone (fail-safe default) — deliberately mirrors
// PitchAccessContact's shape/normalization convention.
model OtpSkipAllowlistEntry {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  note      String?
  createdAt DateTime @default(now())

  @@schema("auth")
}

// Singleton row (id always 1) — admin-portal-editable wallet bonus amount (₹)
// credited once when a customer's profile crosses from incomplete to complete.
// Defaults to 20 until a row exists (see profileCompletionBonusService.js);
// 0 disables the bonus entirely. Read by auth-service when crediting and by
// GET /api/auth/app-config so the customer app can display the real amount.
model ProfileCompletionBonusSetting {
  id        Int      @id @default(1)
  amount    Int
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("auth")
}

enum GobhiType {
  trainer
  cleaner
  manager

  @@schema("auth")
}

enum Role {
  customer
  partner
  gobhi

  @@schema("auth")
}

enum UserType {
  general
  sub_premium
  premium

  @@schema("auth")
}

enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@schema("auth")
}

enum FitnessGoal {
  weight_loss
  muscle_gain
  general_fitness
  flexibility_yoga
  sports_training
  rehabilitation

  @@schema("auth")
}

enum ExperienceLevel {
  new_to_gym
  restarting_after_break
  experienced

  @@schema("auth")
}

enum FrequencyIntent {
  one_two
  three_four
  five_plus

  @@schema("auth")
}