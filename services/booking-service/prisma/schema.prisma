generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["booking"]
}

model Booking {
  id               Int           @id @default(autoincrement())
  customerId       Int
  gymId            Int
  date             String
  startTime        String
  endTime          String
  // Decimal in Postgres (exact, matches wallet-service's Wallet/
  // WalletTransaction/GymSubscription convention) — every read site in
  // bookingService.js runs these through normalizeBookingMoney() immediately
  // after the Prisma call, before any arithmetic or JSON response, since a
  // raw Prisma Decimal object compared with JS `<`/`>` does a STRING compare
  // and `decimalObj + number` can silently string-concatenate.
  amount           Decimal       @db.Decimal(19, 2)
  // Platform commission snapshotted at booking creation (mirrors
  // GymSubscription.commissionPct/partnerShare in wallet-service) — captured
  // once up front so completeBooking always pays out the rate that applied
  // when the customer booked, even if the platform-wide rate changes later.
  // Both null ONLY for a subscription-covered booking under the legacy
  // "upfront" payout model (GymSubscription.payoutModel) — that partner was
  // already paid their full share in one shot at subscription purchase, so
  // there's no separate per-session payout to compute here. A "perVisit"
  // subscription booking DOES get a real partnerShare here (that plan's
  // partnerShare/days, snapshotted at booking-creation time), paid out at
  // completion exactly like a normal paid booking. Null also means "predates
  // this feature" for old non-subscription rows — completeBooking falls back
  // to paying out the full `amount` in that case.
  commissionPct    Decimal?      @db.Decimal(5, 2)
  partnerShare     Decimal?      @db.Decimal(19, 2)
  status           BookingStatus @default(pending)
  walletTxId       Int?
  // Set when this booking was covered by an active GymSubscription instead of
  // a per-session wallet debit — null means the normal paid flow (unchanged).
  // The customer never spent wallet balance on this booking either way (they
  // paid for the subscription itself, separately), so cancelBooking's refund
  // never fires for it — but completeBooking's partner payout DOES fire for
  // it now, unless partnerShare is null (see above).
  subscriptionId   Int?
  // Snapshotted at booking-creation time from the covering GymSubscription's
  // own isAttendanceSaas flag (wallet-service) — meaningless when
  // subscriptionId is null (always false there). true routes this booking's
  // completeBooking payout to wallet-service's PartnerBankSettlement ledger
  // instead of crediting the wallet, same as every other commission field
  // here: captured once so a later change to the gym's opt-out status never
  // retroactively changes how an already-booked visit gets paid.
  isAttendanceSaas Boolean       @default(false)
  // Set for a recurring-class booking instead of a plain-slot booking — the
  // class's own schedule (gym-service's GymClass) governs startTime/endTime
  // for this row, and its capacity pool is tracked separately from the
  // gym's plain-slot capacity (see the (classId, date) index and the
  // amended booking_unique_active_slot index below, both added by the
  // migration that introduced this column). Plain int, no cross-service FK,
  // same convention as gymId.
  classId          Int?
  checkinRequested Boolean       @default(false)
  locationVerified Boolean?

  // Attendance verification — the enforced signal that gates completeBooking's
  // payout. attendedAt is the single source of truth for "did this session
  // count as attended" (drives customer history, partner/admin reporting, and
  // the public aggregate stat). attendanceMethod records how it was proven;
  // null means this predates the feature or was never verified.
  attendedAt               DateTime?
  attendanceMethod         AttendanceMethod?
  attendanceVerifiedBy     Int?
  attendanceOverrideReason String?

  // True once a partner scanned this booking's QR before its session window
  // opened and chose to proceed anyway — startTime/endTime were shifted to
  // match the actual scan time (see AttendanceWarning for the original
  // values). Customer-facing only; never exposed on partner-facing reads.
  slotShiftWarning Boolean @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // NOTE: there are also partial unique indexes in the DB, added by hand in
  // migration SQL since Prisma's schema DSL has no syntax for a filtered/
  // partial unique index (`prisma db push`/introspection will not see them
  // and may report drift — that's expected, don't let a `db push` silently
  // drop them):
  //   - booking_unique_active_slot on (customerId, gymId, date, startTime)
  //     WHERE status <> 'cancelled' AND "classId" IS NULL — backstops
  //     createBooking's app-level duplicate check for a plain-slot booking.
  //     The "classId" IS NULL clause was added in the same migration that
  //     introduced this column — without it, a class booking whose
  //     startTime happens to coincide with a walk-in slot's startTime would
  //     wrongly collide with this index.
  //   - booking_unique_active_class_occurrence on (customerId, classId, date)
  //     WHERE classId IS NOT NULL AND status <> 'cancelled' — same
  //     protection for a class booking.
  @@index([gymId, date])
  @@index([customerId])
  @@index([gymId, date, attendedAt])
  @@index([attendedAt])
  // Lets the capacity count inside reserveBookingSlot's Serializable
  // transaction (see bookingService.js) satisfy its predicate via an index
  // scan instead of a seq scan — without this, SIREAD locking degrades to
  // page/relation granularity under load, causing spurious serialization
  // conflicts for unrelated concurrent bookings.
  @@index([classId, date])
  @@schema("booking")
}

// A gym trainer's own daily presence — deliberately separate from Booking
// (a trainer has no slot/time-window to book against, just "did they show
// up today"). One row per trainer per day: checking in again the same day
// just bumps checkedInAt rather than creating a duplicate (see
// trainerCheckIn's upsert). trainerId is a bare Int, not a Prisma relation —
// the User row lives in auth-service's own database, same cross-service
// convention as Booking.customerId.
model TrainerAttendance {
  id          Int      @id @default(autoincrement())
  trainerId   Int
  gymId       Int
  date        String
  checkedInAt DateTime @default(now())
  method      String

  @@unique([trainerId, date])
  @@index([gymId, date])
  @@schema("booking")
}

// The trainer half of "which customers is this trainer training" — a
// trainer self-logs themselves against a specific customer BOOKING (not a
// freeform customer pick), so every row has real provenance: it's tied to
// an actual attended session, not a static, driftable assignment. One
// trainer per booking (@unique on bookingId) — logging again just
// overwrites (a correction), it doesn't create a second claim on the same
// session.
model TrainingSession {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  trainerId  Int
  gymId      Int
  customerId Int
  createdAt  DateTime @default(now())

  @@index([trainerId, gymId])
  @@index([customerId])
  @@schema("booking")
}

// Singleton row (id always 1) — admin-portal-editable cancellation tiers,
// read by cancelBooking's refund calc and served to clients so the app's
// policy screen shows the exact same numbers instead of a hand-synced copy.
// tiers shape: [{ maxHoursNotice: number|null, blocked: bool, refundRate: number }, ...]
// ordered ascending by maxHoursNotice (null = "8+ hours, no upper bound").
model CancellationPolicySetting {
  id        Int      @id @default(1)
  tiers     Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@schema("booking")
}

// Admin-defined custom funnels (the /analytics User Journey tab's "Custom
// funnels" section) — steps run against analytics_events (a separate DB/pool,
// see analyticsQueryService.js), not this table; this just persists the
// definition so it can be revisited by name instead of re-entered every time.
// steps shape: [{ event: string, filters?: Record<string,string> }, ...],
// in the order they must occur — enforced per-distinct_id at query time.
model SavedFunnel {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  steps     Json
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("booking")
}

enum BookingStatus {
  pending
  confirmed
  // Attendance has been verified (partner scan or customer self-check-in) —
  // the session is in progress but completeBooking hasn't been called yet.
  // A booking in this state can no longer be cancelled/refunded.
  started
  cancelled
  completed

  @@schema("booking")
}

enum AttendanceMethod {
  qr_scan
  manual_override
  // Customer scans a static per-gym poster QR (a deeplink, not a per-booking
  // one) and self-verifies via geofence — see bookingService.selfCheckIn.
  // Distinct from qr_scan (partner-witnessed) purely for reporting/adoption
  // visibility, not because it's treated as lower-trust: it's gated on an
  // authenticated session + a real active booking + location, same as any
  // other verification path.
  qr_geofence_self
  // Partner-web manual "Verify attendance" (no camera there) — was being
  // written without a matching enum value until this was added; see
  // migration 20260729xxxxxx_add_attendance_warning.
  manual_verify

  @@schema("booking")
}

// One row per early-scan confirmation: a partner scanned this booking's QR
// before its session window opened and chose to proceed, shifting the
// booking's startTime/endTime to match the actual scan time. Lives in
// booking-service (not denormalized onto auth-service's User) following this
// codebase's existing pattern of a service owning its own per-user counters
// (e.g. wallet balance stays in wallet-service). Customer-facing only.
model AttendanceWarning {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  customerId        Int
  gymId             Int
  date              String
  originalStartTime String
  originalEndTime   String
  newStartTime      String
  newEndTime        String
  createdAt         DateTime @default(now())

  @@index([customerId])
  @@index([bookingId])
  @@schema("booking")
}

// Attendance-SaaS wedge: a parallel attendance record for customers who
// joined via a gym's QR/link (User.linkedGymId). Unlike Booking, no
// pre-booking is required — the customer shows up, geofences, and this row
// is created. Also feeds challenge-service's coin/streak pipeline (source
// 'member_checkin') so linked members earn the same streaks/coins as
// booking customers, per the 2026-08-27 decision.
model MemberAttendance {
  id          Int      @id @default(autoincrement())
  customerId  Int
  gymId       Int
  date        String
  checkedInAt DateTime @default(now())

  @@unique([customerId, gymId, date])
  @@index([gymId, date])
  @@index([customerId])
  @@schema("booking")
}
