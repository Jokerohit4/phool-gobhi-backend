generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["health"]
}

// See C:\Users\rohit\Phool-Gobhi\docs\phool-gobhi-health-metrics-implementation-plan-2026-08-27.html
// for the full design doc. Two tracks, deliberately: structured in-app
// logging (Exercise/WorkoutTemplate/WorkoutSession/WorkoutSet) for
// naturally set-based strength training, and the lighter ExerciseRecord for
// duration-based cardio/yoga/other plus device-synced workout summaries —
// HealthKit/Health Connect don't hand over set-level data, so there's
// nothing to decompose a synced workout into.

enum Platform {
  ios
  android

  @@schema("health")
}

// Gates the OS-level HealthKit/Health Connect permission prompt — separate
// from the healthMetrics app-config flag, which only gates whether the
// feature is visible at all. Revoking sets revokedAt rather than deleting
// the row, so "was this ever granted, and when" survives a revoke for audit
// purposes even though DELETE /me wipes every other table for this user.
model HealthConsent {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  grantedAt     DateTime
  revokedAt     DateTime?
  policyVersion String
  platform      Platform
  // FR-09. Which classes of health data the grant covers. Today the only
  // one the product can act on is `logs` - nothing shares health data
  // with a coach, a partner or a leaderboard, because none of those
  // surfaces exist (FR-21 is deferred).
  //
  // So this is storage and a gate, not a settings screen: a scope is
  // added when the surface needing it ships, and the app only offers a
  // toggle for a scope that can change something. Offering "share with
  // your coach" today would imply a data flow that cannot happen.
  scopes        String[]  @default(["logs"])

  @@schema("health")
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
  fullBody

  @@schema("health")
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
  kettlebell
  other

  @@schema("health")
}

// Determines which fields the customer app's active-workout set-row shows
// for this exercise (weight+reps vs. duration vs. duration+distance) — one
// unified session flow handles strength AND cardio/yoga this way, rather
// than forking into separate logging UIs per activity type.
enum LoggingType {
  sets_reps_weight
  duration
  duration_distance

  @@schema("health")
}

// The exercise library — seeded (~80-100 common exercises at launch, see
// prisma/seed.js) plus user-created custom entries (createdByUserId set).
// primaryMuscles/secondaryMuscles drive the muscle-diagram highlight on the
// exercise-detail screen; a custom exercise ships with empty muscle lists
// and no demo/video content until/unless the user (or a future admin tool)
// fills them in.
model Exercise {
  id               Int         @id @default(autoincrement())
  name             String
  muscleGroup      MuscleGroup
  equipment        Equipment
  loggingType      LoggingType
  primaryMuscles   String[]
  secondaryMuscles String[]
  demoImageUrl     String?
  createdByUserId  Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  formVideos        ExerciseFormVideo[]
  templateExercises TemplateExercise[]
  sessionExercises  SessionExercise[]

  @@index([muscleGroup])
  @@index([createdByUserId])
  @@schema("health")
}

// A curated, per-language demo video for one exercise. Content-ops, not
// engineering — see the implementation plan's warning note: someone has to
// find/vet a real video per exercise per language before this table has
// meaningful data. youtubeVideoId only (never the full URL) so the app
// builds the watch/deep-link URL itself and stays free to change embed vs.
// link-out behavior later without a data migration.
model ExerciseFormVideo {
  id              Int      @id @default(autoincrement())
  exerciseId      Int
  exercise        Exercise @relation(fields: [exerciseId], references: [id])
  languageCode    String
  youtubeVideoId  String
  title           String
  channelName     String
  durationSeconds Int
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([exerciseId, languageCode])
  @@schema("health")
}

// A reusable routine — "Push Day," "Leg Day." What a user starts a session
// from (or an "empty workout" skips this entirely — WorkoutSession.templateId
// is nullable for exactly that case).
//
// userId nullable + isSystem (docs/../sprint2/PG-HUNT-001 H-21, added
// 2026-09-11): a system template has no owner and is visible to every
// user, the same way a user's own template is visible only to them. This is
// how the 12 seeded no-equipment routines (prisma/seedHomeTrack.js) are
// shared without copying a row per user — templateService.listTemplatesService
// unions `userId = caller` with `isSystem = true`.
model WorkoutTemplate {
  id          Int            @id @default(autoincrement())
  userId      Int?
  isSystem    Boolean        @default(false)
  name        String
  // System templates only — shown on the routine picker. Null for a user's
  // own templates; they don't need to describe a workout to themselves.
  description String?
  estMinutes  Int?
  level       TemplateLevel?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  exercises TemplateExercise[]
  sessions  WorkoutSession[]
  planDays  WorkoutPlanDay[]

  @@index([userId])
  @@index([isSystem])
  @@schema("health")
}

enum TemplateLevel {
  beginner
  intermediate

  @@schema("health")
}

// One exercise's slot in a template. supersetGroup (nullable) lets 2+
// exercises be paired to alternate without rest between them — modeled now
// even though the v1 Create Routine screen doesn't expose pairing yet, so
// adding that UI later needs no migration.
model TemplateExercise {
  id            Int             @id @default(autoincrement())
  templateId    Int
  template      WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId    Int
  exercise      Exercise        @relation(fields: [exerciseId], references: [id])
  order         Int
  targetSets    Int
  // Exactly one of targetReps/targetDurationSeconds is meaningful per row —
  // which one depends on the exercise's own loggingType (sets_reps_weight
  // vs duration), same split WorkoutSet already has for the real logged
  // values (reps vs durationSeconds). targetReps was NOT-NULL until
  // 2026-09-11: fine while every template exercise was sets_reps_weight,
  // wrong the moment a duration exercise (plank, wall sit — see the home
  // track's seeded routines) needed a target with no rep count at all.
  targetReps            Int?
  targetDurationSeconds Int?
  restSeconds   Int?
  supersetGroup Int?

  @@index([templateId])
  @@schema("health")
}

// A multi-week sequence of templates (D-02/H-22) — a thin wrapper, not a
// new logging concept. Every session it schedules is a normal
// WorkoutSession started from a normal WorkoutTemplate; this only says
// which template belongs on which day.
//
// Free, not sold — see D-02 (docs/../sprint2/PG-HUNT-001): pricing this in
// coins would strand anyone who installed organically rather than through
// the QR-hunt chain, since coins are gym-only per D-01.
model WorkoutPlan {
  id          Int    @id @default(autoincrement())
  // Stable machine key, same convention as CoinCatalogItem.key — referenced
  // by the client and by any future admin tooling; never reuse a key for a
  // different plan.
  key         String @unique
  name        String
  description String?
  weeks       Int
  isSystem    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days       WorkoutPlanDay[]
  activeFor  UserActivePlan[]

  @@schema("health")
}

model WorkoutPlanDay {
  id         Int             @id @default(autoincrement())
  planId     Int
  plan       WorkoutPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekIndex  Int             // 1-based
  dayIndex   Int             // 1-7, 1-based, matches ISO weekday order
  // Null = a scheduled rest day. Deliberately a real day in the plan, not
  // an absence — see planService.getActivePlanService, which always
  // returns exactly `weeks * 7` days so the client never has to guess
  // whether a missing day means "rest" or "not seeded yet".
  templateId Int?
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id])

  @@unique([planId, weekIndex, dayIndex])
  @@schema("health")
}

// One row per user — a user can be actively on at most one plan at a time,
// same simplicity constraint as the rest of this v1. startedOn is the only
// state kept; the current day/week is always DERIVED from calendar days
// elapsed since then (planService), never stored as a separate pointer that
// could desync from it — same "derive on read" principle
// consistencyStreakService already uses for the same reason (a second
// source of truth for a number that's cheap to recompute is a bug waiting
// to happen, not a feature).
model UserActivePlan {
  userId      Int         @id
  planId      Int
  plan        WorkoutPlan @relation(fields: [planId], references: [id])
  startedOn   DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@schema("health")
}

// The attendance-grounded differentiator (see
// phool-gobhi-fitness-plus-BRD.html Tech §2/§3): strength/cardio/etc. type
// picked at finish time in the quick-log sheet. `rest` exists so a
// no-exercise "rest day" entry can still be a first-class WorkoutSession row
// (streak/adherence math wants one row per day, not a null).
enum WorkoutType {
  strength
  cardio
  hiit
  yoga_mobility
  full_body
  rest

  @@schema("health")
}

// One logged gym visit's worth of structured training. endedAt null means
// still in progress (the active-workout screen's live session) — a session
// with endedAt null and startedAt older than ~24h is treated as abandoned by
// the app (never auto-deleted server-side, just not resumed).
model WorkoutSession {
  id           Int              @id @default(autoincrement())
  userId       Int
  templateId   Int?
  template     WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Attendance attachment (Fitness+ delta, 2026-09-08) — set either by the
  // client at session start (if it already knows which booking it's for) or
  // by attendanceService.getOrCreateDraftForAttendance when booking-service's
  // recordAttendanceForWorkout fires on a verified check-in. bookingId is
  // null for attendance-SaaS member check-ins (memberAttendanceId path) and
  // for any session started with no known booking context at all.
  bookingId    Int?
  gymId        Int?
  // 'YYYY-MM-DD' in the user's tz at entry — NOT derived from startedAt at
  // read time, so a session logged just after midnight (or backfilled while
  // travelling) keys to the day the user experienced, not the server's UTC
  // wall-date. Drives streak/adherence grouping once that lands.
  localDate    String?
  // Null until the quick-log sheet's finish step sets it (or a draft is
  // auto-created and never gets confirmed — stays null, excluded from
  // volume/streak math the same way a REST log excludes itself from volume).
  type         WorkoutType?
  // 1-10, set once at finish; null for `type = rest` and for any
  // never-confirmed draft.
  rpe          Int?
  // FR-23. A client-generated id for one logical save, so replaying a
  // queued log after a reconnect returns the session that already exists
  // instead of creating a second one. Null for anything created
  // server-side (the attendance draft) or by a client old enough not to
  // send one.
  clientRef    String?          @unique
  startedAt    DateTime         @default(now())
  endedAt      DateTime?
  // Set once, the first time a finished session successfully credits coins
  // (see gamificationService) — an idempotency guard so retrying/duplicating
  // the finish call can never double-credit, independent of the ledger's own
  // idempotencyKey check (belt-and-suspenders, cheap to keep in sync).
  coinsAwarded Boolean          @default(false)

  exercises SessionExercise[]

  @@index([userId, startedAt])
  @@index([userId, bookingId])
  @@index([userId, localDate])
  @@schema("health")
}

// An exercise actually performed in this session — may differ from the
// template if the user swapped/added something mid-workout (see
// POST /sessions/:id/exercises).
model SessionExercise {
  id            Int            @id @default(autoincrement())
  sessionId     Int
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    Int
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  order         Int
  supersetGroup Int?

  sets WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@schema("health")
}

// The atomic logging unit. `completed` flips on the checkmark tap in the
// active-workout screen — that's the whole interaction, per Strong's "3
// taps to log a set" bar. weightKg/reps apply to sets_reps_weight exercises;
// durationSeconds (and SessionExercise-level distance, tracked via the
// exercise's own loggingType) applies to duration/duration_distance ones.
model WorkoutSet {
  id                Int             @id @default(autoincrement())
  sessionExerciseId Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weightKg          Decimal?        @db.Decimal(6, 2)
  reps              Int?
  durationSeconds   Int?
  distanceMeters    Decimal?        @db.Decimal(8, 2)
  completed         Boolean         @default(false)
  updatedAt         DateTime        @updatedAt

  @@index([sessionExerciseId])
  @@schema("health")
}

enum ExerciseRecordSource {
  manual
  healthkit
  health_connect

  @@schema("health")
}

// Narrower than it used to be in this doc's first draft — no longer covers
// strength (that's WorkoutSession now). Duration-based cardio/yoga/other,
// self-reported or synced. externalId is the source's own record id, used
// only for synced rows (null for manual) so re-syncing the same HealthKit
// workout is a no-op upsert, not a duplicate.
model ExerciseRecord {
  id              Int                  @id @default(autoincrement())
  userId          Int
  source          ExerciseRecordSource
  externalId      String?
  type            String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  caloriesBurned  Int?
  distanceMeters  Decimal?             @db.Decimal(8, 2)
  avgHeartRateBpm Int?
  createdAt       DateTime             @default(now())

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
  @@schema("health")
}

enum DailyActivitySource {
  healthkit
  health_connect

  @@schema("health")
}

// One row per user per day — upserted wholesale on every sync (see
// activityService.syncDailyActivity), never partially patched.
model DailyActivityMetric {
  id                  Int                 @id @default(autoincrement())
  userId              Int
  date                String
  steps               Int?
  activeCalories      Int?
  distanceMeters      Decimal?            @db.Decimal(8, 2)
  restingHeartRateBpm Int?
  source              DailyActivitySource
  syncedAt            DateTime            @default(now())

  @@unique([userId, date])
  @@schema("health")
}

// The metric types a user can log by hand today. Deliberately the union of
// Fitness+ FR-12 (weight, body_fat) and Health+ Phase-1 FR-01 (resting HR,
// sleep, steps, stress, HRV) rather than two separate tables — see the
// BiometricEntry comment for why.
enum BiometricMetric {
  weight
  body_fat
  resting_hr
  sleep_minutes
  steps
  hrv
  stress

  @@schema("health")
}

// Where a value came from. `manual` is the only one written today; the
// device sources exist now so wearable auto-fill later lands in these same
// rows instead of a parallel table (both PG-HEALTH-001 §FR-01 and the
// preventive-health vision doc's user_biometrics require exactly this).
enum BiometricSource {
  manual
  healthkit
  health_connect

  @@schema("health")
}

// Fitness+ FR-12 (body measurements) and Health+ FR-01 (manual biometric
// entry) are the same feature at different scopes, so this is one table, in
// the generic (metric, value, unit, source) shape Health+ Phase 1 needs —
// not a fitness-only weight/body-fat table that Health+ would have to
// duplicate or migrate around.
//
// One row per (user, metric, localDate): re-entering today's weight corrects
// today rather than stacking a second row, which is what the 2-tap "value +
// auto-today" entry implies. A day-grain key also means a future wearable
// sync upserts the same row rather than flooding the series with intraday
// samples — intraday raw data, if it's ever wanted, belongs in the vision
// doc's time-series store, not here.
//
// NOTE: progress photos are deliberately absent. The PRD's own stance is
// "local + encrypted sync only, never surfaced to any share flow" (§6 UX-5),
// so body photos stay on-device rather than living on a public Cloudinary
// URL the way profile pictures do.
model BiometricEntry {
  id        Int             @id @default(autoincrement())
  userId    Int
  metric    BiometricMetric
  // Decimal(8,2) covers every metric on one column: 74.25 kg, 18.5 %,
  // 52 bpm, 420 min, 11,500 steps, 68.5 ms.
  value     Decimal         @db.Decimal(8, 2)
  // Stored per row rather than derived from the metric, so a later unit
  // change (lb, or sleep in hours) never silently reinterprets old rows.
  unit      String
  source    BiometricSource @default(manual)
  localDate String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, metric, localDate])
  @@index([userId, metric, localDate])
  @@schema("health")
}

// DPDPA purpose-limitation config, singleton row (id always 1),
// admin-editable from day one so a retention period can change on legal
// advice without a redeploy — same convention as challenge-service's
// CoinEconomyConfig.
//
// Only PURPOSE-LIMITED TELEMETRY is configurable here. The user's own record
// (sessions, biometrics, personalisation) is deleted with the account, never
// on a timer, and financial records elsewhere are under statutory retention.
// See retentionService.js for why those three buckets must not be conflated.
model RetentionPolicy {
  id                     Int      @id @default(1)
  suggestionFeedbackDays Int      @default(180)
  updatedAt              DateTime @updatedAt
  updatedBy              Int?

  @@schema("health")
}

enum SuggestionVote {
  up
  down
  skip
  done

  @@schema("health")
}

// FR-25/27, but deliberately NOT shaped the way the BRD's Tech §3.2 sketch
// proposed (cycleAware/pregnancyFlag/postpartumFlag booleans server-side).
//
// The suggestion engine only ever needs to know HOW to program, never WHY —
// so this stores the derived mode and nothing else. A user who tells the app
// she's pregnant has that mapped, on-device, to `low_impact_recovery`; the
// medical fact itself is never transmitted or stored. That removes an entire
// class of risk (DB dumps, logs, backups, a future analytics join leaking
// pregnancy status) instead of trying to encrypt it away, and it satisfies
// the BRD's own P6 "never medical" line more honestly than a pregnancyFlag
// column would.
//
// `neutral` is the default and the "Show neutral suggestions" escape hatch
// (FR-25). `female_default` biases toward the lower-body/hip-mobility
// emphasis the doc describes. `low_impact_recovery` suppresses PR pushes
// and aggressive progression.
enum ProgrammingMode {
  neutral
  female_default
  low_impact_recovery

  @@schema("health")
}

enum ExperienceLevel {
  none
  lt_1_year
  one_to_three_years
  over_three_years

  @@schema("health")
}

enum EnergyPattern {
  morning
  afternoon
  evening

  @@schema("health")
}

// FR-26 — "detailed but skippable". Every single field is nullable/defaulted
// precisely because the PRD's P7 principle is that any of it can be skipped
// forever without degrading the app: a null here means "not asked / declined"
// and the engine falls back to neutral behaviour, never to a nag.
model PersonalisationProfile {
  userId           Int              @id
  // The one static body metric kept here for now. Height moves to Health+'s
  // health profile (PG-HEALTH-001 FR-02: height/weight, conditions,
  // medications, allergies, family history) when that lands — this is a
  // deliberate placeholder, not the long-term home.
  //
  // Weight is deliberately NOT here: it lives in BiometricEntry as a
  // time series, so there's exactly one source of truth for "what does this
  // user weigh" instead of a setup copy that immediately goes stale.
  heightCm         Int?
  // Pre-existing bug fixed 2026-09-11:
  // personalisationService/personalisationController have read and written
  // setupWeightKg since this model was built, but the column never existed
  // — any client that actually sent it would have hit a Prisma "Unknown
  // argument" error. Decimal(8,2) to match BiometricEntry.value and every
  // other weight field in this schema.
  setupWeightKg    Decimal?         @db.Decimal(8, 2)
  experienceLevel  ExperienceLevel?
  // Free-form list from a fixed chip set (knee/shoulder/lower_back/wrist/…).
  // Used only to bias volume/impact away from those zones — never rendered
  // back as anything diagnostic.
  injuryZones      String[]
  energyPattern    EnergyPattern?
  // 0 = Sunday .. 6 = Saturday, matching Dart's DateTime.weekday % 7.
  preferredRestDay Int?
  programmingMode  ProgrammingMode  @default(neutral)
  // Set the moment a user opts into personalised (non-neutral) programming.
  // Records THAT consent was given and under which policy version — never
  // what was disclosed to arrive at the mode.
  consentAt        DateTime?
  privacyVersion   String?
  updatedAt        DateTime         @updatedAt

  @@schema("health")
}

// FR-15 — every suggestion the app SHOWS gets a row (vote null until the
// user reacts), not just the ones that get voted on. Without the impression
// side there's no denominator for GS-5 (suggestion uptake), and no honest
// way to evaluate the ML upgrade against the shipped rules later.
// suggestionKey is the readiness engine's own output identity (the
// suggested template id, or 'rest' when it suggested recovery) so feedback
// can be grouped by what was actually recommended.
model SuggestionFeedback {
  id            Int             @id @default(autoincrement())
  userId        Int
  suggestionKey String
  // Snapshot of why it was suggested at display time (readiness state,
  // suggested template) — kept as JSON so evaluating a past suggestion
  // never depends on recomputing today's readiness, which has since moved.
  reasoning     Json?
  vote          SuggestionVote?
  shownAt       DateTime        @default(now())
  votedAt       DateTime?

  @@index([userId, shownAt])
  @@schema("health")
}

// FR-04 — the user's own weekly session target, and the thing the home
// ring is measured against.
//
// Before this, the ring compared everyone to a hardcoded 5 sessions a week
// while `weeklyFrequencyIntent` (collected at onboarding, in auth-service)
// went unread. Someone who said "once or twice a week" saw a ring stuck
// near 40% forever, which inverts the product's own rule that charts
// celebrate consistency rather than shame gaps.
//
// A row exists only once a target has been RESOLVED for the user — either
// they set one, or one was derived from their onboarding intent and
// persisted so the number stops moving under them. `setByUser` keeps those
// two apart: a derived default may be re-derived if onboarding intent
// changes, an explicit choice must never be silently overwritten.
model WeeklyGoal {
  userId          Int      @id
  sessionsPerWeek Int
  setByUser       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("health")
}

// FR-08. Which nudge types a user has switched off. A row means "stop
// sending me this one" — absence means allowed, so the default is opt-in
// without needing a row per user per type.
enum NudgeType {
  log
  comeback

  @@schema("health")
}

model NudgeOptOut {
  userId Int
  type   NudgeType
  at     DateTime  @default(now())

  @@id([userId, type])
  @@schema("health")
}

// Every nudge actually sent. This is not analytics — it is what the
// frequency guards read: max 3 a week, never two within 24 hours. Without a
// record of what went out there is no way to enforce either, and the
// failure mode of getting it wrong is push-spamming someone.
model NudgeLog {
  id     Int       @id @default(autoincrement())
  userId Int
  type   NudgeType
  sentAt DateTime  @default(now())

  @@index([userId, sentAt])
  @@schema("health")
}

// Health+ FR-04 / Tech §08 — both blueprints call this P0 and neither
// shipped it. Every read, write, export and delete of health data, with
// who did it and when.
//
// Deliberately NOT a general application log: it exists so a user (or a
// regulator) can be told who touched their health record, which means it
// records the ACTOR and never the data. No values, no marker names, no
// biometric readings — an audit trail that copies the sensitive rows it is
// auditing has doubled the exposure it was meant to control.
model HealthDataAuditLog {
  id       Int      @id @default(autoincrement())
  // Whose record was touched.
  userId   Int
  // Who touched it — the same id for a self-service action, a staff id
  // when an admin reads someone's data, null for a scheduled job.
  actorId  Int?
  action   String // read | write | export | delete
  dataType String // sessions | biometrics | personalisation | consent | all
  at       DateTime @default(now())

  @@index([userId, at])
  @@schema("health")
}

// --- Fitness assistant (2026-09-18) -----------------------------------------
//
// Lives in health-service rather than a new service on purpose: the gateway
// already proxies /api/health wholesale (no gateway change), this service is
// already a registered DPDPA erasure/export target (no new fan-out entry), and
// the chat has to read the workout sessions and injuryZones that live here
// anyway. A new service would have meant repeating the manual GCP secret
// bootstrap that has already caused one prod incident, for no isolation gain.

enum AssistantRole {
  user
  assistant

  @@schema("health")
}

model AssistantConversation {
  id     Int    @id @default(autoincrement())
  userId Int
  title  String?
  // Rolling compression of everything before summarizedThroughMessageId.
  // This is what keeps the prompt bounded as a conversation grows, instead of
  // the cost per turn climbing with its length.
  summary                    String? @db.Text
  summarizedThroughMessageId Int?
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@schema("health")
}

model AssistantMessage {
  id             Int                   @id @default(autoincrement())
  conversationId Int
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Denormalised so a per-user read or erasure never needs the join.
  userId         Int
  role           AssistantRole
  content        String                @db.Text
  // Which posture and prompt were in force when this was said. Recorded on
  // every turn because the product's advice scope is a decision that has
  // changed once and can change again — without this, "what did we tell this
  // person, under which policy" is unanswerable after the fact.
  policyVersion  String?
  promptVersion  String?
  providerModel  String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  // An audit of what the prompt actually saw (counts and ids, never the
  // content itself) — enough to reconstruct why an answer was what it was,
  // without copying the sensitive rows it was built from.
  usedContext    Json?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@schema("health")
}

// Separate from HealthConsent (device sync) and PersonalisationProfile.consentAt
// (non-neutral programming). This one gates a specific thing: that an AI may
// read your training history and answer questions about your body.
model AssistantConsent {
  userId        Int       @id
  grantedAt     DateTime
  revokedAt     DateTime?
  // Stamped server-side from assistantPolicy.CURRENT_POLICY_VERSION, never
  // accepted from the client — which is what makes "re-consent when the
  // wording changes" enforceable here, unlike HealthConsent.policyVersion
  // (a free-text string the client supplies and nothing validates).
  policyVersion String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("health")
}

// Free-text context the assistant itself learned mid-conversation: goals,
// dietary preferences, allergies, available equipment.
//
// Deliberately NOT the same store as PersonalisationProfile.injuryZones. That
// field has its own consent gate and drives real programming decisions; if the
// assistant wrote into it directly it would be an unaudited side channel into
// a field other features trust. Injuries mentioned in chat land here and are
// used in-session only, until the user explicitly promotes them.
model AssistantMemory {
  id        Int      @id @default(autoincrement())
  userId    Int
  // 'goal' | 'injury_mentioned' | 'allergy' | 'equipment' | 'preference'
  key       String
  value     String
  // 'extracted' (the model inferred it) | 'user_confirmed'
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@schema("health")
}

// One row per accepted message, read as a rolling-window count.
//
// DB-backed rather than in-process because every service here runs with
// min-instances=0: an in-memory counter resets on every cold start and is not
// shared across instances, so it would enforce nothing precisely when load
// made it matter. Same reasoning already applied to OtpCode's cooldown and
// NudgeLog's frequency budget.
model AssistantRateLimitLog {
  id     Int      @id @default(autoincrement())
  userId Int
  sentAt DateTime @default(now())

  @@index([userId, sentAt])
  @@schema("health")
}

// --- Cycle tracking (2026-09-18) --------------------------------------------
//
// RECORDED OVERRIDE. FR-27 (decision dated 2026-09-08) deliberately kept ZERO
// cycle/pregnancy columns server-side: a life-stage disclosure resolved
// ON-DEVICE into a ProgrammingMode enum, and only that coarse mode ever
// reached the server. The stated rationale was that the medical fact itself
// should never be transmitted or stored.
//
// On 2026-09-18 the decision was taken to store cycle dates, predictions and
// phase history server-side, knowingly departing from that. These tables are
// the result. Three things keep that departure contained and reversible:
//
//   1. Their own feature flag (cycleTracking) AND their own consent scope
//      ('cycle_tracking' in HealthConsent.scopes) — two independent gates,
//      because "the feature does not exist" and "this user has not opted in"
//      are different states that must fail differently.
//   2. ProgrammingMode remains the ONLY thing that touches training load.
//      Cycle data feeds it through one derivation; no suggestion code reads
//      CyclePhaseEntry directly. Switch the flag off and the training engine
//      behaves exactly as it does today.
//   3. Both tables are in the DPDPA erasure and export paths from the first
//      commit, not added later.
//
// This is the most sensitive data the platform holds. Treat it accordingly.

enum CyclePhase {
  menstrual
  follicular
  ovulation
  luteal

  @@schema("health")
}

enum CycleEntrySource {
  // The user said so.
  user_logged
  // We derived it from their average cycle length. Kept distinct because a
  // prediction must never be shown back as though it were a fact she reported.
  predicted

  @@schema("health")
}

model CycleTrackingProfile {
  userId Int @id
  // Set when the user opts in. Null means the row exists (from an earlier
  // opt-in) but consent is currently withdrawn.
  consentAt      DateTime?
  privacyVersion String?
  averageCycleLengthDays  Int?
  averagePeriodLengthDays Int?
  lastPeriodStartDate     DateTime? @db.Date
  // Whether cycle sync owns PersonalisationProfile.programmingMode for this
  // user.
  //
  // Without this, the "don't downgrade a user-chosen low-impact mode" guard
  // cannot tell a mode the USER set after an injury from one THIS SERVICE set
  // during her last period — so the first logged period would pin her to
  // low-impact permanently, which is both wrong and unexplainable to her.
  // Set the first time sync legitimately takes ownership; never set when it
  // declined to overwrite a mode it did not set.
  managesProgrammingMode  Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("health")
}

model CyclePhaseEntry {
  id        Int              @id @default(autoincrement())
  userId    Int
  startDate DateTime         @db.Date
  endDate   DateTime?        @db.Date
  phase     CyclePhase
  source    CycleEntrySource
  createdAt DateTime         @default(now())

  @@index([userId, startDate])
  @@schema("health")
}
