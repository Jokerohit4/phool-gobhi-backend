generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["health"]
}

// See C:\Users\rohit\Phool-Gobhi\docs\phool-gobhi-health-metrics-implementation-plan-2026-08-27.html
// for the full design doc. Two tracks, deliberately: structured in-app
// logging (Exercise/WorkoutTemplate/WorkoutSession/WorkoutSet) for
// naturally set-based strength training, and the lighter ExerciseRecord for
// duration-based cardio/yoga/other plus device-synced workout summaries —
// HealthKit/Health Connect don't hand over set-level data, so there's
// nothing to decompose a synced workout into.

enum Platform {
  ios
  android

  @@schema("health")
}

// Gates the OS-level HealthKit/Health Connect permission prompt — separate
// from the healthMetrics app-config flag, which only gates whether the
// feature is visible at all. Revoking sets revokedAt rather than deleting
// the row, so "was this ever granted, and when" survives a revoke for audit
// purposes even though DELETE /me wipes every other table for this user.
model HealthConsent {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  grantedAt     DateTime
  revokedAt     DateTime?
  policyVersion String
  platform      Platform
  // FR-09. Which classes of health data the grant covers. Today the only
  // one the product can act on is `logs` - nothing shares health data
  // with a coach, a partner or a leaderboard, because none of those
  // surfaces exist (FR-21 is deferred).
  //
  // So this is storage and a gate, not a settings screen: a scope is
  // added when the surface needing it ships, and the app only offers a
  // toggle for a scope that can change something. Offering "share with
  // your coach" today would imply a data flow that cannot happen.
  scopes        String[]  @default(["logs"])
  // Which privacy-policy wording each scope was granted under, keyed by scope
  // name ('nutrition', 'medical_records').
  //
  // HealthConsent.policyVersion above is the DEVICE-level grant and is not
  // enough on its own: the ledger surfaces were added later, after people had
  // already consented to device access, and those two consent prompts describe
  // different data. Without this column there is no way to answer "which text
  // did this person actually agree to when they turned on medical records?" —
  // the scope array records THAT they agreed, and to nothing about what.
  //
  // This is the ledger equivalent of assistantPolicy.CURRENT_POLICY_VERSION,
  // which already stores its version per grant. The difference is that the
  // assistant's is server-stamped; this one has to be comparable against the
  // version the client says it displayed, or a stale app could record consent
  // to wording that was never on its screen.
  scopeVersions Json       @default("{}")

  @@schema("health")
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
  fullBody

  @@schema("health")
}

enum Equipment {
  barbell
  dumbbell
  machine
  cable
  bodyweight
  kettlebell
  other

  @@schema("health")
}

// Determines which fields the customer app's active-workout set-row shows
// for this exercise (weight+reps vs. duration vs. duration+distance) — one
// unified session flow handles strength AND cardio/yoga this way, rather
// than forking into separate logging UIs per activity type.
enum LoggingType {
  sets_reps_weight
  duration
  duration_distance

  @@schema("health")
}

// The exercise library — seeded (~80-100 common exercises at launch, see
// prisma/seed.js) plus user-created custom entries (createdByUserId set).
// primaryMuscles/secondaryMuscles drive the muscle-diagram highlight on the
// exercise-detail screen; a custom exercise ships with empty muscle lists
// and no demo/video content until/unless the user (or a future admin tool)
// fills them in.
model Exercise {
  id               Int         @id @default(autoincrement())
  name             String
  muscleGroup      MuscleGroup
  equipment        Equipment
  loggingType      LoggingType
  primaryMuscles   String[]
  secondaryMuscles String[]
  demoImageUrl     String?
  createdByUserId  Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  formVideos        ExerciseFormVideo[]
  templateExercises TemplateExercise[]
  sessionExercises  SessionExercise[]

  @@index([muscleGroup])
  @@index([createdByUserId])
  @@schema("health")
}

// A curated, per-language demo video for one exercise. Content-ops, not
// engineering — see the implementation plan's warning note: someone has to
// find/vet a real video per exercise per language before this table has
// meaningful data. youtubeVideoId only (never the full URL) so the app
// builds the watch/deep-link URL itself and stays free to change embed vs.
// link-out behavior later without a data migration.
model ExerciseFormVideo {
  id              Int      @id @default(autoincrement())
  exerciseId      Int
  exercise        Exercise @relation(fields: [exerciseId], references: [id])
  languageCode    String
  youtubeVideoId  String
  title           String
  channelName     String
  durationSeconds Int
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([exerciseId, languageCode])
  @@schema("health")
}

// A reusable routine — "Push Day," "Leg Day." What a user starts a session
// from (or an "empty workout" skips this entirely — WorkoutSession.templateId
// is nullable for exactly that case).
//
// userId nullable + isSystem (docs/../sprint2/PG-HUNT-001 H-21, added
// 2026-09-11): a system template has no owner and is visible to every
// user, the same way a user's own template is visible only to them. This is
// how the 12 seeded no-equipment routines (prisma/seedHomeTrack.js) are
// shared without copying a row per user — templateService.listTemplatesService
// unions `userId = caller` with `isSystem = true`.
model WorkoutTemplate {
  id          Int            @id @default(autoincrement())
  userId      Int?
  isSystem    Boolean        @default(false)
  name        String
  // System templates only — shown on the routine picker. Null for a user's
  // own templates; they don't need to describe a workout to themselves.
  description String?
  estMinutes  Int?
  level       TemplateLevel?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  exercises TemplateExercise[]
  sessions  WorkoutSession[]
  planDays  WorkoutPlanDay[]

  @@index([userId])
  @@index([isSystem])
  @@schema("health")
}

enum TemplateLevel {
  beginner
  intermediate

  @@schema("health")
}

// One exercise's slot in a template. supersetGroup (nullable) lets 2+
// exercises be paired to alternate without rest between them — modeled now
// even though the v1 Create Routine screen doesn't expose pairing yet, so
// adding that UI later needs no migration.
model TemplateExercise {
  id                    Int             @id @default(autoincrement())
  templateId            Int
  template              WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId            Int
  exercise              Exercise        @relation(fields: [exerciseId], references: [id])
  order                 Int
  targetSets            Int
  // Exactly one of targetReps/targetDurationSeconds is meaningful per row —
  // which one depends on the exercise's own loggingType (sets_reps_weight
  // vs duration), same split WorkoutSet already has for the real logged
  // values (reps vs durationSeconds). targetReps was NOT-NULL until
  // 2026-09-11: fine while every template exercise was sets_reps_weight,
  // wrong the moment a duration exercise (plank, wall sit — see the home
  // track's seeded routines) needed a target with no rep count at all.
  targetReps            Int?
  targetDurationSeconds Int?
  restSeconds           Int?
  supersetGroup         Int?

  @@index([templateId])
  @@schema("health")
}

// A multi-week sequence of templates (D-02/H-22) — a thin wrapper, not a
// new logging concept. Every session it schedules is a normal
// WorkoutSession started from a normal WorkoutTemplate; this only says
// which template belongs on which day.
//
// Free, not sold — see D-02 (docs/../sprint2/PG-HUNT-001): pricing this in
// coins would strand anyone who installed organically rather than through
// the QR-hunt chain, since coins are gym-only per D-01.
model WorkoutPlan {
  id          Int      @id @default(autoincrement())
  // Stable machine key, same convention as CoinCatalogItem.key — referenced
  // by the client and by any future admin tooling; never reuse a key for a
  // different plan.
  key         String   @unique
  name        String
  description String?
  weeks       Int
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days      WorkoutPlanDay[]
  activeFor UserActivePlan[]

  @@schema("health")
}

model WorkoutPlanDay {
  id         Int              @id @default(autoincrement())
  planId     Int
  plan       WorkoutPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekIndex  Int // 1-based
  dayIndex   Int // 1-7, 1-based, matches ISO weekday order
  // Null = a scheduled rest day. Deliberately a real day in the plan, not
  // an absence — see planService.getActivePlanService, which always
  // returns exactly `weeks * 7` days so the client never has to guess
  // whether a missing day means "rest" or "not seeded yet".
  templateId Int?
  template   WorkoutTemplate? @relation(fields: [templateId], references: [id])

  @@unique([planId, weekIndex, dayIndex])
  @@schema("health")
}

// One row per user — a user can be actively on at most one plan at a time,
// same simplicity constraint as the rest of this v1. startedOn is the only
// state kept; the current day/week is always DERIVED from calendar days
// elapsed since then (planService), never stored as a separate pointer that
// could desync from it — same "derive on read" principle
// consistencyStreakService already uses for the same reason (a second
// source of truth for a number that's cheap to recompute is a bug waiting
// to happen, not a feature).
model UserActivePlan {
  userId      Int         @id
  planId      Int
  plan        WorkoutPlan @relation(fields: [planId], references: [id])
  startedOn   DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@schema("health")
}

// The attendance-grounded differentiator (see
// phool-gobhi-fitness-plus-BRD.html Tech §2/§3): strength/cardio/etc. type
// picked at finish time in the quick-log sheet. `rest` exists so a
// no-exercise "rest day" entry can still be a first-class WorkoutSession row
// (streak/adherence math wants one row per day, not a null).
enum WorkoutType {
  strength
  cardio
  hiit
  yoga_mobility
  full_body
  rest

  @@schema("health")
}

// One logged gym visit's worth of structured training. endedAt null means
// still in progress (the active-workout screen's live session) — a session
// with endedAt null and startedAt older than ~24h is treated as abandoned by
// the app (never auto-deleted server-side, just not resumed).
model WorkoutSession {
  id           Int              @id @default(autoincrement())
  userId       Int
  templateId   Int?
  template     WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Attendance attachment (Fitness+ delta, 2026-09-08) — set either by the
  // client at session start (if it already knows which booking it's for) or
  // by attendanceService.getOrCreateDraftForAttendance when booking-service's
  // recordAttendanceForWorkout fires on a verified check-in. bookingId is
  // null for attendance-SaaS member check-ins (memberAttendanceId path) and
  // for any session started with no known booking context at all.
  bookingId    Int?
  gymId        Int?
  // Attendance provenance, snapshotted from booking-service at event time
  // (the /internal/attendance-events payload) - HOW this visit was proven and
  // WHEN the gym recorded it. Only the internal route writes these; the
  // client can set bookingId at session start, which is exactly why bookingId
  // alone must never be read as "attended". Values mirror booking-service's
  // AttendanceMethod enum (qr_scan / qr_geofence_self / manual_verify /
  // manual_override) but are stored as text, not a health-side enum: a second
  // copy of another service's enum drifts the day a value is added there, and
  // an unknown incoming value is dropped to null (unknown provenance) by the
  // service rather than rejected by Postgres mid-event.
  //
  // Null on every row written before this existed. That is deliberate and must
  // stay that way - there is no backfill. A null here means "we cannot prove
  // how this visit was verified", and the insurer-grade score reports it as
  // unknown provenance, never as verified.
  attendedAt       DateTime?
  attendanceMethod String?
  // 'YYYY-MM-DD' in the user's tz at entry — NOT derived from startedAt at
  // read time, so a session logged just after midnight (or backfilled while
  // travelling) keys to the day the user experienced, not the server's UTC
  // wall-date. Drives streak/adherence grouping once that lands.
  localDate    String?
  // Null until the quick-log sheet's finish step sets it (or a draft is
  // auto-created and never gets confirmed — stays null, excluded from
  // volume/streak math the same way a REST log excludes itself from volume).
  type         WorkoutType?
  // 1-10, set once at finish; null for `type = rest` and for any
  // never-confirmed draft.
  rpe          Int?
  // FR-23. A client-generated id for one logical save, so replaying a
  // queued log after a reconnect returns the session that already exists
  // instead of creating a second one. Null for anything created
  // server-side (the attendance draft) or by a client old enough not to
  // send one.
  clientRef    String?          @unique
  startedAt    DateTime         @default(now())
  endedAt      DateTime?
  // Set once, the first time a finished session successfully credits coins
  // (see gamificationService) — an idempotency guard so retrying/duplicating
  // the finish call can never double-credit, independent of the ledger's own
  // idempotencyKey check (belt-and-suspenders, cheap to keep in sync).
  coinsAwarded Boolean          @default(false)

  exercises SessionExercise[]

  @@index([userId, startedAt])
  @@index([userId, bookingId])
  @@index([userId, localDate])
  @@schema("health")
}

// An exercise actually performed in this session — may differ from the
// template if the user swapped/added something mid-workout (see
// POST /sessions/:id/exercises).
model SessionExercise {
  id            Int            @id @default(autoincrement())
  sessionId     Int
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    Int
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  order         Int
  supersetGroup Int?

  sets WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseId])
  @@schema("health")
}

// The atomic logging unit. `completed` flips on the checkmark tap in the
// active-workout screen — that's the whole interaction, per Strong's "3
// taps to log a set" bar. weightKg/reps apply to sets_reps_weight exercises;
// durationSeconds (and SessionExercise-level distance, tracked via the
// exercise's own loggingType) applies to duration/duration_distance ones.
model WorkoutSet {
  id                Int             @id @default(autoincrement())
  sessionExerciseId Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weightKg          Decimal?        @db.Decimal(6, 2)
  reps              Int?
  durationSeconds   Int?
  distanceMeters    Decimal?        @db.Decimal(8, 2)
  completed         Boolean         @default(false)
  updatedAt         DateTime        @updatedAt

  @@index([sessionExerciseId])
  @@schema("health")
}

enum ExerciseRecordSource {
  manual
  healthkit
  health_connect
  // Our own GPS run tracker (run-tracker-spec.html §10) — distinct from
  // healthkit/health_connect because those are device-synced summaries with
  // no route, while this source always carries a RunTrack. adminService's
  // adoption count treats it separately from "synced" for that reason.
  gps_tracker

  @@schema("health")
}

// Narrower than it used to be in this doc's first draft — no longer covers
// strength (that's WorkoutSession now). Duration-based cardio/yoga/other,
// self-reported or synced. externalId is the source's own record id, used
// only for synced rows (null for manual) so re-syncing the same HealthKit
// workout is a no-op upsert, not a duplicate. For gps_tracker rows,
// externalId is the app's own clientRunId (a UUID it generates when the run
// starts), which makes a retried/offline-queued upload idempotent the same
// way a re-synced HealthKit workout is.
model ExerciseRecord {
  id              Int                  @id @default(autoincrement())
  userId          Int
  source          ExerciseRecordSource
  externalId      String?
  type            String
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  caloriesBurned  Int?
  distanceMeters  Decimal?             @db.Decimal(8, 2)
  avgHeartRateBpm Int?
  createdAt       DateTime             @default(now())
  runTrack        RunTrack?

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
  @@schema("health")
}

// One row per GPS-tracked run/walk/cycle, 1:1 with its ExerciseRecord — kept out
// of that table so a plain list of records never drags the polyline along.
// See run-tracker-spec.html §10 for the full field-by-field reasoning
// (splits, polyline precision, why weightKgUsed is frozen at save time).
model RunTrack {
  id               Int            @id @default(autoincrement())
  exerciseRecordId Int            @unique
  exerciseRecord   ExerciseRecord @relation(fields: [exerciseRecordId], references: [id], onDelete: Cascade)
  // Google encoded polyline, precision 5, Douglas-Peucker simplified
  // client-side (~2 m tolerance) before upload.
  polyline         String         @db.Text
  // A small (<=40 point), further-simplified polyline for list thumbnails,
  // so GET /runs never has to ship the full-resolution route.
  thumbPolyline    String         @db.Text
  // [{ km: 1, seconds: 392 }, ...] — one entry per completed kilometre.
  splits           Json
  movingSeconds    Int
  elapsedSeconds   Int
  avgPaceSecPerKm  Int?
  bestKmSeconds    Int?
  pauseCount       Int            @default(0)
  pointCount       Int
  hadGap           Boolean        @default(false)
  weightKgUsed     Decimal?       @db.Decimal(5, 1)
  appVersion       String?
  platform         Platform?
  createdAt        DateTime       @default(now())

  @@schema("health")
}

enum DailyActivitySource {
  healthkit
  health_connect

  @@schema("health")
}

// One row per user per day — upserted wholesale on every sync (see
// activityService.syncDailyActivity), never partially patched.
model DailyActivityMetric {
  id                  Int                 @id @default(autoincrement())
  userId              Int
  date                String
  steps               Int?
  activeCalories      Int?
  distanceMeters      Decimal?            @db.Decimal(8, 2)
  restingHeartRateBpm Int?
  source              DailyActivitySource
  syncedAt            DateTime            @default(now())

  @@unique([userId, date])
  @@schema("health")
}

// The metric types a user can log by hand today. Deliberately the union of
// Fitness+ FR-12 (weight, body_fat) and Health+ Phase-1 FR-01 (resting HR,
// sleep, steps, stress, HRV) rather than two separate tables — see the
// BiometricEntry comment for why.
enum BiometricMetric {
  weight
  body_fat
  resting_hr
  sleep_minutes
  steps
  hrv
  stress

  @@schema("health")
}

// Where a value came from. `manual` is the only one written today; the
// device sources exist now so wearable auto-fill later lands in these same
// rows instead of a parallel table (both PG-HEALTH-001 §FR-01 and the
// preventive-health vision doc's user_biometrics require exactly this).
enum BiometricSource {
  manual
  healthkit
  health_connect

  @@schema("health")
}

// Fitness+ FR-12 (body measurements) and Health+ FR-01 (manual biometric
// entry) are the same feature at different scopes, so this is one table, in
// the generic (metric, value, unit, source) shape Health+ Phase 1 needs —
// not a fitness-only weight/body-fat table that Health+ would have to
// duplicate or migrate around.
//
// One row per (user, metric, localDate): re-entering today's weight corrects
// today rather than stacking a second row, which is what the 2-tap "value +
// auto-today" entry implies. A day-grain key also means a future wearable
// sync upserts the same row rather than flooding the series with intraday
// samples — intraday raw data, if it's ever wanted, belongs in the vision
// doc's time-series store, not here.
//
// NOTE: progress photos are deliberately absent. The PRD's own stance is
// "local + encrypted sync only, never surfaced to any share flow" (§6 UX-5),
// so body photos stay on-device rather than living on a public Cloudinary
// URL the way profile pictures do.
model BiometricEntry {
  id        Int             @id @default(autoincrement())
  userId    Int
  metric    BiometricMetric
  // Decimal(8,2) covers every metric on one column: 74.25 kg, 18.5 %,
  // 52 bpm, 420 min, 11,500 steps, 68.5 ms.
  value     Decimal         @db.Decimal(8, 2)
  // Stored per row rather than derived from the metric, so a later unit
  // change (lb, or sleep in hours) never silently reinterprets old rows.
  unit      String
  source    BiometricSource @default(manual)
  localDate String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, metric, localDate])
  @@index([userId, metric, localDate])
  @@schema("health")
}

// Consent to store the body numbers a person TYPES IN (weight, body fat, and
// the Health+ quick-add metrics), kept apart from HealthConsent on purpose.
//
// HealthConsent is the device-access grant: it has a required `platform` and
// describes reading HealthKit / Health Connect. Someone logging their weight by
// hand has never been asked about device access, and may never want it, so
// hanging this off HealthConsent (as the ledger scopes do) would force a
// person to connect Apple Health before they could type "72 kg". That is the
// wrong consent answering the wrong question.
//
// Same shape as AssistantConsent, and for the same reason: the version is
// stamped by the server from biometricConsentService.BIOMETRIC_POLICY_VERSION,
// never accepted from the client, which is what makes "ask again when the
// wording changes" enforceable. Revoke is soft (revokedAt), so "did this person
// ever agree, and when" survives a withdrawal.
model BiometricConsent {
  userId        Int       @id
  grantedAt     DateTime
  revokedAt     DateTime?
  policyVersion String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("health")
}

// DPDPA purpose-limitation config, singleton row (id always 1),
// admin-editable from day one so a retention period can change on legal
// advice without a redeploy — same convention as challenge-service's
// CoinEconomyConfig.
//
// Only PURPOSE-LIMITED TELEMETRY is configurable here. The user's own record
// (sessions, biometrics, personalisation) is deleted with the account, never
// on a timer, and financial records elsewhere are under statutory retention.
// See retentionService.js for why those three buckets must not be conflated.
model RetentionPolicy {
  id                     Int      @id @default(1)
  suggestionFeedbackDays Int      @default(180)
  updatedAt              DateTime @updatedAt
  updatedBy              Int?

  @@schema("health")
}

enum SuggestionVote {
  up
  down
  skip
  done

  @@schema("health")
}

// FR-25/27, but deliberately NOT shaped the way the BRD's Tech §3.2 sketch
// proposed (cycleAware/pregnancyFlag/postpartumFlag booleans server-side).
//
// The suggestion engine only ever needs to know HOW to program, never WHY —
// so this stores the derived mode and nothing else. A user who tells the app
// she's pregnant has that mapped, on-device, to `low_impact_recovery`; the
// medical fact itself is never transmitted or stored. That removes an entire
// class of risk (DB dumps, logs, backups, a future analytics join leaking
// pregnancy status) instead of trying to encrypt it away, and it satisfies
// the BRD's own P6 "never medical" line more honestly than a pregnancyFlag
// column would.
//
// `neutral` is the default and the "Show neutral suggestions" escape hatch
// (FR-25). `female_default` biases toward the lower-body/hip-mobility
// emphasis the doc describes. `low_impact_recovery` suppresses PR pushes
// and aggressive progression.
enum ProgrammingMode {
  neutral
  female_default
  low_impact_recovery

  @@schema("health")
}

enum ExperienceLevel {
  none
  lt_1_year
  one_to_three_years
  over_three_years

  @@schema("health")
}

enum EnergyPattern {
  morning
  afternoon
  evening

  @@schema("health")
}

// FR-26 — "detailed but skippable". Every single field is nullable/defaulted
// precisely because the PRD's P7 principle is that any of it can be skipped
// forever without degrading the app: a null here means "not asked / declined"
// and the engine falls back to neutral behaviour, never to a nag.
model PersonalisationProfile {
  userId           Int              @id
  // The one static body metric kept here for now. Height moves to Health+'s
  // health profile (PG-HEALTH-001 FR-02: height/weight, conditions,
  // medications, allergies, family history) when that lands — this is a
  // deliberate placeholder, not the long-term home.
  //
  // Weight is deliberately NOT here: it lives in BiometricEntry as a
  // time series, so there's exactly one source of truth for "what does this
  // user weigh" instead of a setup copy that immediately goes stale.
  heightCm         Int?
  // Pre-existing bug fixed 2026-09-11:
  // personalisationService/personalisationController have read and written
  // setupWeightKg since this model was built, but the column never existed
  // — any client that actually sent it would have hit a Prisma "Unknown
  // argument" error. Decimal(8,2) to match BiometricEntry.value and every
  // other weight field in this schema.
  setupWeightKg    Decimal?         @db.Decimal(8, 2)
  experienceLevel  ExperienceLevel?
  // Free-form list from a fixed chip set (knee/shoulder/lower_back/wrist/…).
  // Used only to bias volume/impact away from those zones — never rendered
  // back as anything diagnostic.
  injuryZones      String[]
  energyPattern    EnergyPattern?
  // 0 = Sunday .. 6 = Saturday, matching Dart's DateTime.weekday % 7.
  preferredRestDay Int?
  programmingMode  ProgrammingMode  @default(neutral)
  // Set the moment a user opts into personalised (non-neutral) programming.
  // Records THAT consent was given and under which policy version — never
  // what was disclosed to arrive at the mode.
  consentAt        DateTime?
  privacyVersion   String?
  // Home setup (onboarding audit P2, 2026-10-01): asked once at the first
  // "Start workout" on the home track. Values are the fixed sets in
  // services/homeSetup.js — what a person HAS, which is not the same list as
  // Exercise.equipment (what a move USES). Read by the routine list (fit
  // badge + ordering), the suggestion engine and the coach, so nothing here
  // is collected without a reader.
  homeEquipment    String[]         @default([])
  trainingSpace    String?
  // When the home-setup sheet was answered. Separate from the two fields
  // because "I have nothing" is an answer ([] / 'none'), and without this the
  // app could not tell it from "never asked" — it would ask again forever.
  homeSetupAt      DateTime?
  updatedAt        DateTime         @updatedAt

  @@schema("health")
}

// FR-15 — every suggestion the app SHOWS gets a row (vote null until the
// user reacts), not just the ones that get voted on. Without the impression
// side there's no denominator for GS-5 (suggestion uptake), and no honest
// way to evaluate the ML upgrade against the shipped rules later.
// suggestionKey is the readiness engine's own output identity (the
// suggested template id, or 'rest' when it suggested recovery) so feedback
// can be grouped by what was actually recommended.
model SuggestionFeedback {
  id            Int             @id @default(autoincrement())
  userId        Int
  suggestionKey String
  // Snapshot of why it was suggested at display time (readiness state,
  // suggested template) — kept as JSON so evaluating a past suggestion
  // never depends on recomputing today's readiness, which has since moved.
  reasoning     Json?
  vote          SuggestionVote?
  shownAt       DateTime        @default(now())
  votedAt       DateTime?

  @@index([userId, shownAt])
  @@schema("health")
}

// FR-04 — the user's own weekly session target, and the thing the home
// ring is measured against.
//
// Before this, the ring compared everyone to a hardcoded 5 sessions a week
// while `weeklyFrequencyIntent` (collected at onboarding, in auth-service)
// went unread. Someone who said "once or twice a week" saw a ring stuck
// near 40% forever, which inverts the product's own rule that charts
// celebrate consistency rather than shame gaps.
//
// A row exists only once a target has been RESOLVED for the user — either
// they set one, or one was derived from their onboarding intent and
// persisted so the number stops moving under them. `setByUser` keeps those
// two apart: a derived default may be re-derived if onboarding intent
// changes, an explicit choice must never be silently overwritten.
model WeeklyGoal {
  userId          Int      @id
  sessionsPerWeek Int
  setByUser       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("health")
}

// FR-08. Which nudge types a user has switched off. A row means "stop
// sending me this one" — absence means allowed, so the default is opt-in
// without needing a row per user per type.
enum NudgeType {
  log
  comeback
  // "You are behind the score target you set." Added last; the opt-out join
  // keys on (userId, type) and stores the value by name, so order is
  // irrelevant.
  target

  @@schema("health")
}

model NudgeOptOut {
  userId Int
  type   NudgeType
  at     DateTime  @default(now())

  @@id([userId, type])
  @@schema("health")
}

// Every nudge actually sent. This is not analytics — it is what the
// frequency guards read: max 3 a week, never two within 24 hours. Without a
// record of what went out there is no way to enforce either, and the
// failure mode of getting it wrong is push-spamming someone.
model NudgeLog {
  id     Int       @id @default(autoincrement())
  userId Int
  type   NudgeType
  sentAt DateTime  @default(now())

  @@index([userId, sentAt])
  @@schema("health")
}

// Health+ FR-04 / Tech §08 — both blueprints call this P0 and neither
// shipped it. Every read, write, export and delete of health data, with
// who did it and when.
//
// Deliberately NOT a general application log: it exists so a user (or a
// regulator) can be told who touched their health record, which means it
// records the ACTOR and never the data. No values, no marker names, no
// biometric readings — an audit trail that copies the sensitive rows it is
// auditing has doubled the exposure it was meant to control.
model HealthDataAuditLog {
  id       Int      @id @default(autoincrement())
  // Whose record was touched.
  userId   Int
  // Who touched it — the same id for a self-service action, a staff id
  // when an admin reads someone's data, null for a scheduled job.
  actorId  Int?
  action   String // read | write | export | delete
  dataType String // sessions | biometrics | personalisation | consent | all
  at       DateTime @default(now())

  @@index([userId, at])
  @@schema("health")
}

// --- Fitness assistant (2026-09-18) -----------------------------------------
//
// Lives in health-service rather than a new service on purpose: the gateway
// already proxies /api/health wholesale (no gateway change), this service is
// already a registered DPDPA erasure/export target (no new fan-out entry), and
// the chat has to read the workout sessions and injuryZones that live here
// anyway. A new service would have meant repeating the manual GCP secret
// bootstrap that has already caused one prod incident, for no isolation gain.

enum AssistantRole {
  user
  assistant

  @@schema("health")
}

model AssistantConversation {
  id                         Int       @id @default(autoincrement())
  userId                     Int
  title                      String?
  // Rolling compression of everything before summarizedThroughMessageId.
  // This is what keeps the prompt bounded as a conversation grows, instead of
  // the cost per turn climbing with its length.
  summary                    String?   @db.Text
  summarizedThroughMessageId Int?
  archivedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@schema("health")
}

model AssistantMessage {
  id               Int                   @id @default(autoincrement())
  conversationId   Int
  conversation     AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Denormalised so a per-user read or erasure never needs the join.
  userId           Int
  role             AssistantRole
  content          String                @db.Text
  // Which posture and prompt were in force when this was said. Recorded on
  // every turn because the product's advice scope is a decision that has
  // changed once and can change again — without this, "what did we tell this
  // person, under which policy" is unanswerable after the fact.
  policyVersion    String?
  promptVersion    String?
  providerModel    String?
  tokensIn         Int?
  tokensOut        Int?
  // Part of tokensIn, not additional to it: how much of the prompt the
  // provider served from its prefix cache. Cached tokens are discounted and
  // exempt from the provider rate limit, so this is what says how much quota
  // headroom is really left. Null means the provider did not report it.
  tokensCached     Int?
  latencyMs        Int?
  // An audit of what the prompt actually saw (counts and ids, never the
  // content itself) — enough to reconstruct why an answer was what it was,
  // without copying the sensitive rows it was built from.
  usedContext      Json?
  // The system prompt verbatim, exactly as the model received it. usedContext
  // above says how MUCH fed an answer; this says WHAT, which is the only form
  // that helps when a user reports the coach saying something wrong. Entirely
  // derived from rows this service already holds, on a table already in the
  // erasure and export paths, beside the user's own free text - so it opens no
  // exposure that was not already open.
  usedSystemPrompt String?               @db.Text
  createdAt        DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@schema("health")
}

// Separate from HealthConsent (device sync) and PersonalisationProfile.consentAt
// (non-neutral programming). This one gates a specific thing: that an AI may
// read your training history and answer questions about your body.
model AssistantConsent {
  userId        Int       @id
  grantedAt     DateTime
  revokedAt     DateTime?
  // Stamped server-side from assistantPolicy.CURRENT_POLICY_VERSION, never
  // accepted from the client — which is what makes "re-consent when the
  // wording changes" enforceable here, unlike HealthConsent.policyVersion
  // (a free-text string the client supplies and nothing validates).
  policyVersion String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("health")
}

// Free-text context the assistant itself learned mid-conversation: goals,
// dietary preferences, allergies, available equipment.
//
// Deliberately NOT the same store as PersonalisationProfile.injuryZones. That
// field has its own consent gate and drives real programming decisions; if the
// assistant wrote into it directly it would be an unaudited side channel into
// a field other features trust. Injuries mentioned in chat land here and are
// used in-session only, until the user explicitly promotes them.
model AssistantMemory {
  id        Int      @id @default(autoincrement())
  userId    Int
  // 'goal' | 'injury_mentioned' | 'allergy' | 'equipment' | 'preference'
  key       String
  value     String
  // 'extracted' (the model inferred it) | 'user_confirmed'
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // (userId, key, VALUE), not (userId, key): allergies and injuries are
  // additive, and keying on the pair alone made every new one silently
  // overwrite the last. Cardinality is now declared per key in
  // memoryService.KEY_POLICY — 'one' keys replace on write, 'many' accumulate
  // up to their cap. Including value also makes restating a fact idempotent.
  @@unique([userId, key, value])
  @@index([userId, key])
  @@schema("health")
}

// One row per accepted message, read as a rolling-window count.
//
// DB-backed rather than in-process because every service here runs with
// min-instances=0: an in-memory counter resets on every cold start and is not
// shared across instances, so it would enforce nothing precisely when load
// made it matter. Same reasoning already applied to OtpCode's cooldown and
// NudgeLog's frequency budget.
model AssistantRateLimitLog {
  id     Int      @id @default(autoincrement())
  userId Int
  sentAt DateTime @default(now())

  @@index([userId, sentAt])
  @@schema("health")
}

// --- Cycle tracking (2026-09-18) --------------------------------------------
//
// RECORDED OVERRIDE. FR-27 (decision dated 2026-09-08) deliberately kept ZERO
// cycle/pregnancy columns server-side: a life-stage disclosure resolved
// ON-DEVICE into a ProgrammingMode enum, and only that coarse mode ever
// reached the server. The stated rationale was that the medical fact itself
// should never be transmitted or stored.
//
// On 2026-09-18 the decision was taken to store cycle dates, predictions and
// phase history server-side, knowingly departing from that. These tables are
// the result. Three things keep that departure contained and reversible:
//
//   1. Their own feature flag (cycleTracking) AND their own consent scope
//      ('cycle_tracking' in HealthConsent.scopes) — two independent gates,
//      because "the feature does not exist" and "this user has not opted in"
//      are different states that must fail differently.
//   2. ProgrammingMode remains the ONLY thing that touches training load.
//      Cycle data feeds it through one derivation; no suggestion code reads
//      CyclePhaseEntry directly. Switch the flag off and the training engine
//      behaves exactly as it does today.
//   3. Both tables are in the DPDPA erasure and export paths from the first
//      commit, not added later.
//
// This is the most sensitive data the platform holds. Treat it accordingly.

enum CyclePhase {
  menstrual
  follicular
  ovulation
  luteal

  @@schema("health")
}

enum CycleEntrySource {
  // The user said so.
  user_logged
  // We derived it from their average cycle length. Kept distinct because a
  // prediction must never be shown back as though it were a fact she reported.
  predicted

  @@schema("health")
}

model CycleTrackingProfile {
  userId                  Int       @id
  // Set when the user opts in. Null means the row exists (from an earlier
  // opt-in) but consent is currently withdrawn.
  consentAt               DateTime?
  privacyVersion          String?
  averageCycleLengthDays  Int?
  averagePeriodLengthDays Int?
  lastPeriodStartDate     DateTime? @db.Date
  // Whether cycle sync owns PersonalisationProfile.programmingMode for this
  // user.
  //
  // Without this, the "don't downgrade a user-chosen low-impact mode" guard
  // cannot tell a mode the USER set after an injury from one THIS SERVICE set
  // during her last period — so the first logged period would pin her to
  // low-impact permanently, which is both wrong and unexplainable to her.
  // Set the first time sync legitimately takes ownership; never set when it
  // declined to overwrite a mode it did not set.
  managesProgrammingMode  Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@schema("health")
}

model CyclePhaseEntry {
  id        Int              @id @default(autoincrement())
  userId    Int
  startDate DateTime         @db.Date
  endDate   DateTime?        @db.Date
  phase     CyclePhase
  source    CycleEntrySource
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, startDate])
  @@schema("health")
}

// --- Health Ledger (2026-09-27) ---------------------------------------------
//
// See C:\Users\rohit\Phool-Gobhi\docs\phool-gobhi-health-ledger-plan-20260927.html.
//
// The shape of this whole block is dictated by ONE decision, recorded 2026-09-27
// and load-bearing everywhere below: the app TRACKS the doctor's plan, it never
// WRITES one. Software that generates a plan because of a condition is a
// regulated medical device under CDSCO; software that manages a general wellness
// goal is not. Everything in this schema exists to make that line structural
// rather than a matter of care in a prompt or a UI string:
//
//   - NutritionTarget.source is `formula` or `user_edited`. There is no third
//     value, and no field anywhere holds "because you have anemia, eat iron".
//     A target is computed from body numbers and a goal TYPE, nothing else.
//   - PlanItem.prescribedBy is free text the USER typed. The generator
//     (planGenerator.js) structurally cannot write a row with origin `doctor`:
//     it is the one writer that is not allowed, and the tests assert it.
//   - PlanItem carries no nutrient, dose or biomarker claim of any kind. A
//     doctor item is "Iron tablet, after lunch" — a string the user owns —
//     not "65 mg elemental iron".
//   - MedicalDocument is a record. It is never read, OCR'd or interpreted by
//     anything in this service; there is no code path from a stored document
//     to a target or a plan item.
//
// The three consent scopes this adds (`nutrition`, `medical_records`, and the
// photo request log below) follow the location_routes pattern: separate,
// separately withdrawable, and both erased and exported from the first commit.

enum Sex {
  male
  female
  other

  @@schema("health")
}

// The six goals the intake offers. All six are WELLNESS goals in the CDSCO
// sense. There is deliberately no goal type that names a condition — "follow
// my doctor's plan" (doctor_plan) takes the user down the records path, where
// their own doctor's instructions become plan items, rather than asking the
// engine to treat anything.
enum HealthGoalType {
  build_muscle
  lose_fat
  // Same weight on the scale, more muscle and less fat. Replaces the
  // narrower "gain_weight", which carried a *larger* surplus than
  // build_muscle and so pulled a beginner towards fat gain.
  recomp
  endurance
  general_health
  doctor_plan

  @@schema("health")
}

// Starting activity guess from the intake, replaced by MEASURED activity
// (workouts, runs, steps) after 14 days of data. Same reason
// PersonalisationProfile.preferredRestDay is stored rather than derived from
// the day: a number that silently moves under someone is a bug, and the whole
// point of asking is that they answered.
enum ActivityLevel {
  sedentary
  light
  moderate
  very_active

  @@schema("health")
}

enum DietPattern {
  veg
  egg
  non_veg
  vegan
  jain

  @@schema("health")
}

enum MealSlot {
  breakfast
  lunch
  snack
  dinner

  @@schema("health")
}

// How a food entered the log. `photo_confirmed` is the only one that implies
// a model was involved, and it still means the USER confirmed every row —
// the model proposes ids from our own FoodItem table, it never invents a
// food and never writes a nutrient value.
enum FoodLogSource {
  search
  photo_confirmed
  saved_meal
  custom

  @@schema("health")
}

// Whether a target came out of the formula or out of the user's own edit.
// A `user_edited` target is never silently overwritten by a recompute — see
// nutritionService.recomputeTargets, which refuses to clobber it.
enum TargetSource {
  formula
  user_edited

  @@schema("health")
}

enum PlanItemKind {
  nutrition
  workout
  habit
  doctor_medication
  doctor_test
  doctor_appointment
  rest

  @@schema("health")
}

// Where a plan item came from. This is the field that makes the medical line
// visible in the product: the user always sees which of these produced the
// thing they are being asked to do.
enum PlanItemOrigin {
  suggested
  doctor
  user

  @@schema("health")
}

// --- Goal intake ------------------------------------------------------------

// One row per user. The intake is the only writer, and every field is
// nullable/skippable: "skipped the whole setup" must be a valid state that
// the rest of the feature can read without special-casing.
model HealthGoal {
  userId             Int            @id
  goal               HealthGoalType
  // Sex and age are cached here rather than read from auth-service on every
  // target recompute. They are copied ONCE, at intake, and never re-synced:
  // they are inputs to a historical calculation, and a target that silently
  // re-derives itself when someone edits their profile is exactly the
  // "number moving under them" failure the app is meant to avoid.
  sex                Sex?
  age                Int?
  // Height is cached here once, at intake, and never re-synced, on the same
  // terms as sex and age above. computeTargets() cannot produce a number
  // without it.
  //
  // This is where PersonalisationProfile.heightCm was always meant to end up —
  // its own comment says it is "a deliberate placeholder, not the long-term
  // home" pending PG-HEALTH-001 FR-02. That column is left in place and still
  // read as a fallback by ledger/targetService.js, because dropping a populated
  // column is a data migration and not something a feature branch should do
  // silently. Once the fallback is retired, the placeholder can go.
  heightCm           Int?
  //
  // There is deliberately NO weightKg here. Weight is a time series in
  // BiometricEntry(metric='weight'), and PersonalisationProfile already
  // records the decision in a comment: "Weight is deliberately NOT here: it
  // lives in BiometricEntry as a time series, so there's exactly one source of
  // truth for 'what does this user weigh' instead of a setup copy that
  // immediately goes stale." A second copy on this table would reintroduce
  // precisely that staleness — a user who loses weight would recompute against
  // the weight they set their goal at, and the target would stop matching the
  // body in front of them. targetService resolves weight from BiometricEntry
  // and returns "missing: ['weight']" when there is no reading.
  // 'YYYY-MM-DD' in the user's tz, same convention as BiometricEntry.localDate
  // and WorkoutSession.localDate. A string, not a timestamp, because the day
  // boundary is the user's day and IST midnight is a different instant from
  // UTC midnight for most of the day.
  startDate          String
  targetWeightKg     Decimal?       @db.Decimal(5, 1)
  targetDate         String?
  activity           ActivityLevel?
  diet               DietPattern?
  // Free text, the user's own words ("peanuts", "shellfish"). Used only to
  // WARN on search results — never to filter, never to constrain a target.
  // An allergy list that silently removed foods would make the log lie.
  allergies          String[]       @default([])
  // Populated once measured activity supersedes the `activity` guess, so the
  // targets screen can say which of the two produced the number.
  activityIsMeasured Boolean        @default(false)
  // Calm mode: the whole chart renders as one green line with no red candles.
  //
  // This is the plan's eating-disorder guard made switchable — "the whole chart
  // can be switched to calm mode (no red, just the green line)". Calorie
  // tracking plus red loss days is a known trigger, and a user who has decided
  // the numbers are hurting them must be able to turn that off without
  // deleting their history or leaving the feature.
  //
  // Default false, because the ledger is worthless without the misses and
  // nobody should be opted out of information by default. It is one tap from
  // the chart header, and turning it on is never buried in settings.
  //
  // This is a DISPLAY preference, not a scoring rule. computeDay still computes
  // the same numbers; calm mode only changes how they are painted, so toggling
  // it can never rewrite a stored snapshot or change a user's total.
  calmMode           Boolean        @default(false)
  // A pause is the score's off-ramp, and it exists because a cumulative line
  // that only ever moves down has no exit for the exact people who most need
  // to come back: someone ill, injured, travelling, or simply in a bad stretch.
  // Without it the comeback nudge is asking a user who is already being
  // punished every day to also respond to a notification.
  //
  // A paused day is NEUTRAL, not skipped: it earns nothing, is charged no
  // misses, and the chain passes through it unchanged, so a flat snapshot row is
  // still written and the next day resumes from the same close. The pause stays
  // visible in the series rather than being hidden, so a flat stretch is
  // explained by the pause instead of looking like the app lost the user's data.
  //
  // Inclusive on both ends, and both are the user's local day string, the same
  // convention as BiometricEntry.localDate. PausedUntil is capped at start +
  // MAX_PAUSE_DAYS by scoreService.setPause - the cap lives in the service, not
  // only in the client, so the score cannot be paused indefinitely by calling
  // the API directly.
  pausedFrom         String?
  pausedUntil        String?
  // The score the user is aiming at, and the window they gave themselves to
  // reach it in. This is the answer to "what number am I trying to hit", which
  // is a question the score engine cannot ask itself: it produces a number every
  // day but has no opinion about what any of them are for.
  //
  // A threshold on the RUNNING TOTAL, not on points earned within the window.
  // The distinction matters and is easy to get backwards. The score is cumulative
  // and can fall - a missed doctor item is -10, a missed workout -15, a day can
  // lose 40 - so progress toward this target can go backwards too. That is the
  // honest reading of a running total, and it is why the card reports pace
  // against the user's own target rather than a streak the app could keep on
  // their behalf.
  //
  // `scoreTargetPoints` is absolute rather than relative, so "get to 400" means
  // 400 on the chain and not 400 more than wherever the user happened to be. The
  // two readings differ by the whole history, and the absolute one is what a
  // person means when they look at a number on a chart.
  //
  // The window is stored as two local day strings rather than a day count,
  // because a count has no end: it would have to be re-derived against today's
  // date on every read and would silently change meaning. ScoreTargetFrom is the
  // day the clock started, so the baseline is knowable after the fact.
  //
  // Pause interaction: paused days do NOT extend this window. A pause freezes the
  // score, and the target is measured on the score, so extending the deadline
  // would be extending a deadline because the thing being measured stopped
  // moving. What a pause does do is stop the days counting as lost - see
  // scoreTargetService, which subtracts paused days from the elapsed count rather
  // than from the deadline, so the pace maths stays honest and the user is never
  // shown as behind for a fortnight they were explicitly told to stop.
  scoreTargetPoints   Int?
  scoreTargetFrom     String?
  scoreTargetUntil    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Derived entirely from the goal, so it is deleted with it rather than
  // orphaned. See NutritionTarget.goalRow for the back-reference.
  target NutritionTarget?

  @@schema("health")
}

// Conditions in the user's OWN words. No codes, no ontology, no lookup table.
//
// That is the whole design. A coded condition list is what turns "I track your
// doctor" into "I diagnose you", and it is also a re-identification vector:
// a rare coded condition plus a gym check-in is a person. Free text is
// storable, exportable and erasable, and it feeds nothing.
model HealthCondition {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  // 'user_stated' is the only value today and is kept explicit so that if a
  // future clinician-entered source is ever added, "who said this" is
  // answerable per row rather than unknowable.
  source    String   @default("user_stated")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("health")
}

// One row per user. Replaced wholesale on recompute, not patched, EXCEPT when
// source = 'user_edited' — see the TargetSource comment.
model NutritionTarget {
  userId       Int            @id
  goal         HealthGoalType
  kcal         Int
  proteinG     Int
  carbsG       Int
  fatG         Int
  fibreG       Int
  waterMl      Int
  // The micronutrient RDA the plan actually shows (iron, magnesium, calcium,
  // zinc, ...). Always the normal daily allowance for the user's age and sex
  // from ICMR-NIN 2020 — never a therapeutic dose, never elevated because of
  // a condition. Storing them in one map rather than a column each is what
  // makes "never a treatment level" checkable: there is exactly one place a
  // nutrient level can come from, and it is the RDA table.
  micros       Json
  // Every input the formula used, so "Why these numbers?" can always explain
  // itself months later without re-deriving from data that has since changed.
  // This is the difference between a target that can answer for itself and one
  // that has to guess.
  inputs       Json
  source       TargetSource   @default(formula)
  // Bumped when the formula changes, so a frozen historical day's score stays
  // explicable even after the engine is retuned. Stored on ScoreDaySnapshot
  // too; the two must be allowed to differ and that is the point.
  rulesVersion String         @default("v1")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // The back-reference for HealthGoal.target. Named `goalRow` because the
  // `goal` above is the goal TYPE — a scalar, and the more important of the
  // two: it is the input the formula ran with, and it is deliberately a
  // snapshot rather than a read-through, so retitling a goal later cannot
  // retroactively relabel the targets it produced.
  goalRow HealthGoal @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@schema("health")
}

// --- Food database ----------------------------------------------------------

// Per 100 g, raw or as-cooked depending on `basis`. Serving sizes are
// household units (katori, roti, glass) because "150 g of poha" is not an
// instruction anyone follows at 7am.
model FoodItem {
  id              Int      @id @default(autoincrement())
  name            String
  // Hinglish and regional aliases, searched alongside the name. "poha",
  // "chipta", "kanda poha" all have to find the same row or the food log is
  // unusable for the people it is actually for.
  aliases         String[] @default([])
  // 'raw' | 'cooked' | 'as_served' — an oil-soaked aloo bhaji and a boiled
  // potato are the same food and a 3x calorie difference.
  basis           String   @default("cooked")
  kcal            Decimal  @db.Decimal(8, 2)
  proteinG        Decimal  @db.Decimal(8, 2)
  carbsG          Decimal  @db.Decimal(8, 2)
  fatG            Decimal  @db.Decimal(8, 2)
  fibreG          Decimal  @db.Decimal(8, 2)
  // Key micronutrients per 100 g. Sparse on purpose — only the ones the
  // targets screen actually shows, so the column is not a nutrition database
  // pretending to be a curated one.
  ironMg          Decimal? @db.Decimal(8, 2)
  magnesiumMg     Decimal? @db.Decimal(8, 2)
  calciumMg       Decimal? @db.Decimal(8, 2)
  zincMg          Decimal? @db.Decimal(8, 2)
  // [{ label: 'katori', grams: 150 }, { label: 'plate', grams: 200 }]
  servings        Json?
  veg             Boolean  @default(true)
  // Non-veg foods are marked rather than hidden so a search for "curry" can
  // still find them with a visible flag.
  nonVeg          Boolean  @default(false)
  // A custom food the user created. Never shared, never seeded over, and
  // erased with the account.
  createdByUserId Int?
  // Where the nutrient numbers came from: 'ifct2017', 'usda', 'label-scan',
  // 'user-entered', 'estimate'. Provenance, not authority — a row can be
  // perfectly traceable and still unverified.
  //
  // This exists because "verified: false" alone cannot tell a reviewing
  // nutritionist whether a value was looked up in IFCT or typed from memory.
  // A seed value nobody can trace is worse than no value, because it looks
  // like data.
  source          String?
  // Signed off by a qualified nutritionist against `source`. False for every
  // seeded row until that happens, and the food search filters on it by
  // default — an unverified row is still findable with an explicit flag, for
  // the user who wants to log a katori of something we do not carry.
  verified        Boolean  @default(false)
  // Who signed it off, when, and what they said. Without these, `verified` is a
  // flag some script flipped and "a qualified nutritionist checked this" is not
  // a claim anyone can check. Nullable because every seeded row is unverified
  // and the three must be written together by the sign-off path.
  verifiedBy      String?
  verifiedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs FoodLog[]

  @@index([name])
  @@index([createdByUserId])
  @@schema("health")
}

// What was eaten, on which day, in which meal.
//
// `nutrients` is a SNAPSHOT of the FoodItem's values at log time, copied onto
// the row. The alternative — reading through to FoodItem on read — means an
// admin correcting a seed value silently rewrites what someone ate three
// months ago, and the day statement stops being a true statement. A score
// chart that can change after the fact is not a ledger.
model FoodLog {
  id               Int           @id @default(autoincrement())
  userId           Int
  foodItemId       Int?
  foodItem         FoodItem?     @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  localDate        String
  slot             MealSlot
  grams            Decimal       @db.Decimal(8, 2)
  // 'plate' | 'katori' | '2 rotis' — what the user actually said, kept next to
  // the resolved grams so the portion can be corrected by name.
  servingLabel     String?
  servings         Decimal?      @db.Decimal(5, 2)
  // { kcal, proteinG, carbsG, fatG, fibreG, ironMg, ... } at log time.
  nutrients        Json
  source           FoodLogSource
  // The user edited what the model proposed. Tracked as a number so the
  // photo feature can be judged on it (the plan's own launch metric: if more
  // than half of photo logs get corrected, the feature is not earning its
  // cost).
  photoCorrections Int           @default(0)
  // Set only when the log came from a photo, and only after the user confirmed
  // it. GCS object path, never a URL: the bucket has no public access, so a path
  // on its own cannot become a picture without minting a signed link per read.
  // See foodPhotoStorage.js.
  photoPath         String?
  // What the model proposed for this line, retained AFTER confirmation. The
  // counter above says how often the model was wrong; this is what makes that
  // number debuggable, because "corrected 4 times" cannot tell you whether it
  // swapped dal for rice or misread an entire plate.
  photoProposedName String?
  // The provider's confidence in its own proposal, 0..1, or null when it did not
  // report one. Kept so a confidence threshold can be chosen from real numbers
  // later instead of guessed now.
  photoConfidence   Float?
  // Which model produced the proposal. Prompt and model version move together,
  // and without this an accuracy regression cannot be dated.
  photoModel        String?
  // Name and veg flag copied at log time, alongside `nutrients`. The same
  // reason as the nutrient snapshot, extended to presentation: a day's log
  // renders without a join, and the label survives the FoodItem being deleted
  // (which is a SetNull, so the relation really does go away).
  //
  // The snapshot is the source of truth for VALUES. These two are for display,
  // which is why they are plain strings rather than a resolved relation.
  name            String
  nonVeg          Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, localDate])
  @@index([userId, createdAt])
  @@schema("health")
}

// A one-tap repeat meal. The reason most food logs die is that logging the
// same breakfast five days running is still five decisions; this makes the
// fifth one a single tap.
model SavedMeal {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  slot      MealSlot
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SavedMealLine[]

  @@index([userId])
  @@schema("health")
}

model SavedMealLine {
  id           Int       @id @default(autoincrement())
  savedMealId  Int
  savedMeal    SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodItemId   Int?
  // Name and nutrients are copied here for the same reason as FoodLog: a
  // saved meal that changes when someone edits a custom food is a saved meal
  // that quietly stops being what you ate.
  name         String
  nonVeg       Boolean  @default(false)
  grams        Decimal   @db.Decimal(8, 2)
  servingLabel String?
  nutrients    Json
  // Preserves the order lines were logged in, so a repeated meal reads the way
  // it was eaten rather than in an arbitrary order.
  order        Int       @default(0)

  // Relation to the source food is intentionally NOT declared. SavedMealLine
  // copies name and nutrients, so it stays correct even if the custom food it
  // was built from is later edited or deleted — a saved meal that silently
  // changed shape would be worse than one that cannot be re-resolved.
  @@index([savedMealId])
  @@schema("health")
}

// --- Plan -------------------------------------------------------------------

model PlanItem {
  id             Int            @id @default(autoincrement())
  userId         Int
  kind           PlanItemKind
  // Free text, always shown to the user. For a doctor item this is EXACTLY
  // what they typed off the prescription — there is no medicine picker
  // anywhere in the product, because a picker is us suggesting a dose.
  title          String
  // 'daily' | 'weekly' | ISO weekday list | a specific 'YYYY-MM-DD' for a
  // one-off test or appointment.
  schedule       String         @default("daily")
  origin         PlanItemOrigin @default(suggested)
  // Who prescribed it, in the user's words. Null for everything else. Free
  // text, never a doctor directory lookup, never validated.
  prescribedBy   String?
  prescribedNote String?
  // Nutrition-target items (e.g. "hit 130 g protein") point here rather than
  // hardcoding a number, so editing the target retargets the plan item
  // instead of leaving a stale goal in the plan. Null for non-nutrition items.
  nutrientKey    String?
  targetValue    Decimal?       @db.Decimal(8, 2)
  // 0 = every day. 1 = alternate days. A plan with 20 items turns every day
  // red, so the intake and generator both keep it small and the user can
  // remove anything.
  active         Boolean        @default(true)
  // Items the generator created, so a regenerate can replace them without
  // touching a doctor item or a user item. This is what makes "regenerate
  // the plan" safe rather than destructive.
  autoGenerated  Boolean        @default(false)
  // A soft end date — "until 20 Dec" off a prescription. The item stops
  // scoring after it but is never auto-deleted, because stopping someone's
  // course of tablets because a date passed is not this service's call.
  endsOn         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  completions PlanItemCompletion[]

  @@index([userId, active])
  @@schema("health")
}

model PlanItemCompletion {
  id         Int      @id @default(autoincrement())
  planItemId Int
  planItem   PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  userId     Int
  localDate  String
  // Points this specific tick contributed, 0 for an auto-satisfied item
  // (a workout that the session log already credited) and 0 for a
  // backfilled tick older than the late-logging window.
  points     Int      @default(0)
  // 'manual' | 'auto' — whether the user tapped it or a log satisfied it.
  how        String   @default("manual")
  createdAt  DateTime @default(now())

  @@unique([planItemId, localDate])
  @@index([userId, localDate])
  @@schema("health")
}

// --- Medical records (storage only) -----------------------------------------

// A private document the user chose to keep. It is NEVER read: no OCR, no
// model, no parse. The column is a storage path and a description, and
// nothing in this service ever opens the object for anything except handing
// the user a signed link to it.
//
// Kept out of Cloudinary on purpose — those buckets are public-by-URL and
// content-addressed for profile pictures, which is the wrong shape for a lab
// report.
model MedicalDocument {
  id          Int      @id @default(autoincrement())
  userId      Int
  // Object path, never a signed URL. A signed URL in a database row expires,
  // and a permanently valid one in a log is a leak.
  storagePath String
  kind        String // 'prescription' | 'lab_report' | 'scan' | 'other'
  title       String
  docDate     String?
  notes       String?
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@schema("health")
}

model DoctorAppointment {
  id           Int      @id @default(autoincrement())
  userId       Int
  doctorName   String
  speciality   String?
  // 'YYYY-MM-DD' + 'HH:mm' in the user's own tz. A doctor's appointment is
  // not a UTC instant — 10:30 at a clinic in Gurugram is a wall-clock time
  // and a reminder has to fire against it.
  localDate    String
  localTime    String?
  followUpDate String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, localDate])
  @@schema("health")
}

// --- The ledger itself ------------------------------------------------------

// One FROZEN row per day, written at day close and never recomputed.
//
// The freeze is the product. A running score that recalculates when a rule
// changes is a mood, not a ledger — and a candle whose open/high/low/close
// can move tomorrow is not a candle. `breakdown` keeps every line item that
// moved the score so the day statement can always be reconstructed, and
// `rulesVersion` records which engine produced it so a rule change is visible
// as a discontinuity rather than a silent rewrite of history.
model ScoreDaySnapshot {
  id           Int      @id @default(autoincrement())
  userId       Int
  localDate    String
  // Yesterday's close. Null for the first day ever — the score starts at 0,
  // and the plan is explicit that it starts at 0 rather than at a baseline
  // invented to look flattering.
  open         Int
  high         Int
  low          Int
  close        Int
  // [{ key, label, kind, points, detail }] — every line, earned and lost.
  breakdown    Json
  rulesVersion String
  // A day inside a pause. The OHLC are all equal on such a day and the breakdown
  // is empty, so this flag is what separates "paused" from "a day where nothing
  // happened" - the second is a real 0, the first is an absence. The two must
  // never be confused: a user who paused through illness and a user who did
  // nothing produce the same chart shape unless this column is read.
  paused Boolean @default(false)
  closedAt DateTime @default(now())

  @@unique([userId, localDate])
  @@index([userId, localDate])
  @@schema("health")
}

// Rate limit for the paid vision model. DB-backed for the same reason
// AssistantRateLimitLog is: every service here runs min-instances=0, so an
// in-memory counter resets on cold start and enforces nothing precisely when
// load makes it matter.
model FoodPhotoRequestLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  requestedAt DateTime @default(now())
  // This table is the cost ledger for a paid vision call, so it records what
  // happened and not merely that a request arrived. `requestedAt` alone answers
  // "is this user hammering the endpoint", which is the rate-limit question; the
  // rest answers the one that decides whether the feature is worth its price.
  //
  // outcome: 'ok' (foods matched the catalogue) | 'no_food' (a photo of
  // something that is not food, or nothing identifiable) | 'rejected' (nothing
  // was logged from this photo) | 'provider_error' | 'rate_limited'.
  outcome       String?
  latencyMs     Int?
  // Token counts, so per-photo spend can be attributed and a prompt change can
  // be shown to have made it more expensive rather than merely different.
  tokensIn      Int?
  tokensOut     Int?
  // Where the photo went, so an image nobody ever confirmed can be reclaimed.
  // Null when the request failed before anything was stored.
  photoPath     String?
  model         String?
  // How many proposed items the catalogue did not contain. The honest early
  // signal that the model is naming things we have never heard of: a high rate
  // here means the catalogue is the bottleneck, not the vision model.
  unmatchedCount Int     @default(0)
  // The user later confirmed nothing from this photo. Set on the row when the
  // photo is swept, so abandonment is measurable instead of inferred from a
  // missing FoodLog.
  abandonedAt   DateTime?

  @@index([userId, requestedAt])
  @@schema("health")
}

// ---------------------------------------------------------------------------
// Health profile (gamified onboarding v2, 2026-10-01).
//
// The "get to know you" answers: five asked at signup (allergies, weight,
// height, drinking, smoking — each with "prefer not to say" as a first-class
// answer), the rest filled in over time from the Profile tab for a coin each.
//
// One row per person rather than spreading these across HealthGoal and
// PersonalisationProfile. HealthGoal only exists after Health+ intake, and
// PersonalisationProfile is the training-programming record; neither is the
// home for "who cooks your food" or "where are you from". Weight and height
// are deliberately NOT columns here — weight is a BiometricEntry time series
// and height lives on PersonalisationProfile.heightCm (the fallback ledger
// targetService already reads), so there is still exactly one place each
// number lives. The two *Declined booleans record only that the person chose
// not to say, so the mandatory step can tell "declined" from "never asked".
//
// Every value is from a fixed set in services/healthProfile.js except
// allergies (the user's own words, capped) and hometown (capped free text).
// Each field has a named reader there (FIELD_CONSUMERS) — nothing here is
// collected without one.
//
// greens / otherSubstances are the most sensitive columns in this service.
// They reach the coach (the user's explicit choice) and the user's own DPDP
// export, and nothing else: not analytics, not admin, not insurer-grade, not
// FHIR. Enforced by tests, not just by this comment.
model HealthProfile {
  userId           Int       @id
  // 'none' | 'has' | 'prefer_not'. 'has' requires at least one allergy.
  allergyStatus    String?
  allergies        String[]  @default([])
  weightDeclined   Boolean   @default(false)
  heightDeclined   Boolean   @default(false)
  // never | occasionally | weekly | daily | prefer_not
  drinking         String?
  smoking          String?
  greens           String?
  otherSubstances  String?
  broughtHere      String[]  @default([])
  mealsPerDay      Int?
  followsDiet      Boolean?
  dietType         String?
  whoCooks         String?
  occupation       String?
  workingHours     String?
  healthSpend      String?
  wearsSpectacles  Boolean?
  spectaclesType   String?
  hometown         String?
  // 'none' | 'has' | 'prefer_not'. The reminders themselves are rows in
  // MedicationReminder; this records the answer so "I take nothing" is
  // distinguishable from "never asked".
  medicationsStatus String?
  // Question keys whose one-time coin has been credited. The coin ledger's
  // idempotency key already makes a second credit impossible; this copy is so
  // the app can show "already earned" without a cross-service call.
  coinKeys         String[]  @default([])
  // When the five signup questions were last fully answered (any answer,
  // including "prefer not to say").
  basicsAnsweredAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@schema("health")
}

// Consent to hold the sensitive health-profile answers (allergies, drinking,
// smoking, substances, medications). Shaped exactly like BiometricConsent and
// AssistantConsent: server-stamped policy version, revoke sets revokedAt.
// Non-sensitive answers (hometown, who cooks, occupation…) and every
// "prefer not to say" need no consent — declining to disclose is not health
// data.
model HealthProfileConsent {
  userId        Int       @id
  grantedAt     DateTime
  revokedAt     DateTime?
  policyVersion String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("health")
}

// A medicine the user wants reminding about. Used ONLY to schedule the
// user's own reminders (on-device notifications) and to let the coach
// acknowledge that reminders exist. It never changes a plan, a target or a
// score — see healthProfile.js MEDICATION_NOTE for the one fixed line shown
// alongside it. Free-text name, capped; times are 'HH:MM' local.
model MedicationReminder {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  times     String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@schema("health")
}

model HealthReport {
  id               Int       @id @default(autoincrement())
  userId           Int
  cloudinaryUrl    String
  fileName         String
  status           ReportStatus @default(PENDING)
  processedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  extractions      ReportExtraction[]

  @@index([userId])
  @@schema("health")
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED

  @@schema("health")
}

model ReportExtraction {
  id               Int      @id @default(autoincrement())
  reportId         Int
  report           HealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metric           BiometricMetric
  rawValue         String   // The exact text found in the PDF (e.g. "5.7%")
  normalizedValue  Decimal? @db.Decimal(8, 2)
  unit             String?
  confidence      Float    @default(0) // 0.0 to 1.0
  isVerified       Boolean   @default(false) // Verified by user
  createdAt        DateTime    @default(now())

  @@index([reportId])
  @@schema("health")
}
