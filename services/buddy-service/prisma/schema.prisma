generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["buddy"]
}

// Mirrors auth-service's Gender enum (services/auth-service/prisma/schema.prisma).
// Prisma's multiSchema mode can't share an enum across schemas, so this is a
// duplicated definition — keep the values identical to auth-service's by convention.
enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@schema("buddy")
}

// Mirrors auth-service's FitnessGoal enum — same convention as Gender above.
enum FitnessGoal {
  weight_loss
  muscle_gain
  general_fitness
  flexibility_yoga
  sports_training
  rehabilitation

  @@schema("buddy")
}

enum SwipeAction {
  like
  pass

  @@schema("buddy")
}

enum MatchStatus {
  active
  unmatched
  // Set by lazy expiry (see expireStaleMatches). Distinct from `unmatched`,
  // which means a person ended it. Kept apart so "nobody replied to you" and
  // "you unmatched them" stay distinguishable in the match list and in
  // support conversations.
  expired

  @@schema("buddy")
}

model BuddyProfile {
  id             Int           @id @default(autoincrement())
  userId         Int           @unique
  bio            String?       @db.VarChar(500)
  // Optional, user-supplied — deliberately excluded from the completion
  // score (unlike bio/photos) since it's a nice-to-have, not required.
  socialMediaUrl String?       @db.VarChar(255)
  // Denormalized cache of auth-service fields, needed for SQL-level discovery
  // filtering (WHERE gender IN / dateOfBirth BETWEEN / fitnessGoals && ...).
  // auth-service remains the source of truth; refreshed on profile create and
  // via POST /internal/profile-sync/:userId (called by auth-service on edit)
  // or POST /api/buddy/profile/refresh (manual client fallback).
  gender         Gender?
  dateOfBirth    DateTime?     @db.Date
  fitnessGoals   FitnessGoal[]
  lastSyncedAt   DateTime?
  // Approximate "home" location for vicinity matching, set at profile
  // creation from the app's location picker/GPS, editable via PUT profile.
  lat            Float
  lng            Float
  isDiscoverable Boolean       @default(true)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  photos         BuddyPhoto[]
  filter         BuddyFilter?

  // NOTE (upgrade path, not built now): at scale, replace the lat/lng
  // BETWEEN pre-filter with a proper geo index (PostGIS earthdistance/GiST,
  // or a ll_to_earth() functional index) instead of plain btree ranges.
  @@index([lat, lng])
  @@index([isDiscoverable, isActive])
  @@schema("buddy")
}

model BuddyPhoto {
  id             Int          @id @default(autoincrement())
  buddyProfileId Int
  url            String
  publicId       String?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  buddyProfile   BuddyProfile @relation(fields: [buddyProfileId], references: [id], onDelete: Cascade)

  @@index([buddyProfileId, order])
  @@schema("buddy")
}

model BuddyFilter {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  buddyProfile BuddyProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  radiusKm     Int           @default(25)
  minAge       Int           @default(18)
  maxAge       Int           @default(60)
  genders      Gender[]
  fitnessGoals FitnessGoal[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@schema("buddy")
}

model Swipe {
  id        Int         @id @default(autoincrement())
  swiperId  Int
  swipeeId  Int
  action    SwipeAction
  createdAt DateTime    @default(now())

  // Idempotency: re-swiping the same target is a no-op, not a duplicate row.
  @@unique([swiperId, swipeeId])
  @@index([swipeeId, action])
  @@schema("buddy")
}

model Match {
  id          Int           @id @default(autoincrement())
  userLowId   Int
  userHighId  Int
  status      MatchStatus   @default(active)
  unmatchedBy Int?
  unmatchedAt DateTime?
  matchedAt   DateTime      @default(now())
  // Last time this conversation saw activity — a message either way. Expiry is
  // measured from here, NOT from matchedAt: a year-old match that was active
  // last week must not be treated as stale, and matchedAt cannot express that.
  // Defaults to matchedAt so an existing match is never born already expired,
  // and bumped on sendMessage.
  lastActivityAt DateTime    @default(now())
  messages    ChatMessage[]

  // Canonical min/max ordering + this unique constraint is the concurrency
  // guard for near-simultaneous mutual swipes — see swipeService.recordSwipe.
  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  // Supports the lazy-expiry sweep's WHERE status + lastActivityAt range.
  @@index([status, lastActivityAt])
  @@schema("buddy")
}

model ChatMessage {
  id        Int       @id @default(autoincrement())
  matchId   Int
  senderId  Int
  body      String    @db.VarChar(1000)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
  @@schema("buddy")
}

// Blocking: model, endpoints, and enforcement in both the discovery feed and
// the swipe path, plus auto-unmatch so a block severs an existing conversation.
// See Report below for the reporting side, which was added 2026-10-04.
model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@schema("buddy")
}

// Why someone was reported. A closed taxonomy, not free text: a gobhi triaging
// a queue needs to filter "how many harassment reports are open", and free-text
// reasons cannot be counted. `other` carries the user's own words in `details`,
// which is the only place prose is allowed.
enum ReportReason {
  harassment
  inappropriate_content
  impersonation
  spam
  underage
  scam
  threat
  other

  @@schema("buddy")
}

enum ReportStatus {
  open
  // A gobhi looked and closed it with no action.
  dismissed
  // Action was taken against the reported user (typically blocked, possibly
  // escalated). Kept distinct from `dismissed` so "we looked and did nothing"
  // is never conflated with "we looked and acted" in a moderation metric.
  actioned

  @@schema("buddy")
}

// A safety report about another user.
//
// Deliberately NOT a foreign key to either user, and both ids are plain
// nullable Ints rather than relations. Two reasons:
//   - buddy-service has no relation to auth-service's User table (separate
//     services, separate schemas, no cross-service FK is possible), so the
//     referential integrity is conventional everywhere else in this schema too.
//   - erasureService nulls `reportedUserId` rather than deleting the row when
//     the REPORTED user erases. A safety record has to outlive the account it
//     describes, but so does the obligation to stop retaining a pointer to an
//     erased person. Dropping the identifier satisfies both; deleting the row
//     would destroy the record, and keeping it would retain erased personal
//     data. `reporterId` is deleted outright — that is the reporter's own data,
//     with no safety claim over it.
model Report {
  id Int @id @default(autoincrement())
  // Set to NULL when the reported user erases their account. See above.
  reportedUserId Int?
  reporterId     Int
  reason         ReportReason
  // Free text. Only ever the `other` reason's elaboration; capped hard because
  // this is unreviewed user prose going straight into an admin surface.
  details String? @db.VarChar(1000)
  status  ReportStatus @default(open)
  // Null until a gobhi triages it, then the staff id. Distinct from
  // `reporterId` so "who reported" and "who reviewed" can't be confused.
  reviewedBy      Int?
  reviewedAt      DateTime?
  resolutionNote  String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())

  // Triage queue: the only query that matters is "open reports, newest first".
  @@index([status, createdAt])
  // "Every report ever filed about this person" — the question you ask when
  // deciding whether one more report tips into action.
  @@index([reportedUserId])
  // A reporter cannot spam the queue about one person.
  @@unique([reporterId, reportedUserId])
  @@schema("buddy")
}
