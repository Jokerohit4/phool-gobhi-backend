DATABASE_URL=postgresql://user:pass@localhost:5432/gymdb
GYM_SERVICE_PORT=5004
BOOKING_SERVICE_URL=http://localhost:5005
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OpenRouteService Matrix API key (free tier) — real driving-distance labels
# on gym listings. Optional: missing/invalid key just falls back to the
# existing straight-line distance, nothing breaks.
ORS_API_KEY=your_ors_api_key
