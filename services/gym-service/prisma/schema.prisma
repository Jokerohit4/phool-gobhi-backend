generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["gym"]
}

model Gym {
  id           Int         @id @default(autoincrement())
  partnerId    Int
  name         String
  description  String?
  address      String
  city         String
  state        String
  lat          Float
  lng          Float
  amenities    String[]
  phone        String
  // Money fields are Decimal in Postgres (exact, no binary-float rounding
  // drift on repeated writes/aggregates) but every read site in
  // gymService.js converts them back to a plain JS Number immediately after
  // the Prisma call, before any arithmetic or JSON response — mirrors
  // wallet-service's established pattern (see its Wallet/WalletTransaction
  // models + the Number(...) wrapping throughout walletService.js). Comparing
  // two Prisma Decimal objects with JS's `<`/`>` does a STRING compare, and
  // `decimalObj + number` can silently string-concatenate — normalizing at
  // the boundary avoids ever hitting either footgun downstream.
  sessionPrice Decimal     @db.Decimal(19, 2)
  quotedPrice  Decimal?    @db.Decimal(19, 2)
  established  Int?
  brandDocs    String[]
  openTime     String
  closeTime    String
  slotDuration Int         @default(60)
  capacity     Int         @default(20)
  rating       Float       @default(0)
  ratingCount  Int         @default(0)
  // Linked once, at gym create/edit time, by picking an address from Places
  // autocomplete (see placesService.js) — null until then, and refreshable
  // on demand from the partner dashboard (refreshGoogleRating).
  googlePlaceId         String?
  googleRating          Float?
  googleRatingCount     Int?
  googleRatingUpdatedAt DateTime?
  // Per-category aggregates, recomputed the same way rating/ratingCount are
  // (see addReview/deleteReview) — nullable because a review can rate some
  // categories and skip others, and *Count tracks only that category's
  // non-null review count so the website can hide categories nobody rated.
  equipmentRating           Float?
  equipmentRatingCount      Int?     @default(0)
  cleanlinessRating         Float?
  cleanlinessRatingCount    Int?     @default(0)
  trainerRating             Float?
  trainerRatingCount        Int?     @default(0)
  valueForMoneyRating       Float?
  valueForMoneyRatingCount  Int?     @default(0)
  staffBehaviourRating      Float?
  staffBehaviourRatingCount Int?     @default(0)
  crowdRating               Float?
  crowdRatingCount          Int?     @default(0)
  isApproved   Boolean     @default(false)
  rejectionReason String?
  isActive     Boolean     @default(true)
  // Platform commission on this gym's bookings/subscriptions, admin-editable
  // (gobhi-only, see PUT /:id/commission) — 20 is the platform default for
  // every gym until an admin overrides it.
  commissionPct Decimal    @default(20) @db.Decimal(5, 2)
  // Attendance-SaaS wedge: when this gym first went live (isApproved flipped
  // true), set once in approveGym and never moved after — drives wallet-
  // service's 1-month honeymoon window on GymSubscription purchases. Null
  // until first approval. Backfilled to createdAt for gyms already approved
  // before this feature existed (see migration) so no already-live gym gets
  // a free honeymoon it never had.
  partnershipStartDate DateTime?
  // Post-honeymoon commission on GymSubscription purchases specifically —
  // separate lever from commissionPct, which keeps governing one-off
  // marketplace bookings unchanged. Null = platform default (see
  // DEFAULT_SUBSCRIPTION_SAAS_COMMISSION_PERCENT in wallet-service).
  subscriptionCommissionPct Decimal? @db.Decimal(5, 2)
  weeklyPlanPrice     Decimal? @db.Decimal(19, 2)
  monthlyPlanPrice    Decimal? @db.Decimal(19, 2)
  quarterlyPlanPrice  Decimal? @db.Decimal(19, 2)
  sixMonthlyPlanPrice Decimal? @db.Decimal(19, 2)
  yearlyPlanPrice     Decimal? @db.Decimal(19, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  images       GymImage[]
  reviews      GymReview[]
  slotBlocks   SlotBlock[]
  slotPrices   GymSlotPrice[]
  editRequests GymEditRequest[]
  operatingHours GymOperatingHours[]
  classes        GymClass[]

  @@index([partnerId])
  @@schema("gym")
}

model GymImage {
  id        Int      @id @default(autoincrement())
  gymId     Int
  url       String
  publicId  String?
  // "image" | "video" — plain string rather than a Postgres enum to match
  // this schema's existing style (no enums elsewhere) and keep the
  // hand-authored migration a trivial ADD COLUMN. Videos only ever arrive
  // via the browser-direct signed-upload path (see upload.js) — the old
  // server-side multipart path stays image-only, since Cloud Run's request
  // body limit rules out uploading real video through it anyway.
  mediaType String   @default("image")
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@schema("gym")
}

model GymReview {
  id         Int      @id @default(autoincrement())
  gymId      Int
  customerId Int
  rating     Float
  comment    String?
  // Optional per-category scores (1-5) — a customer can rate any subset,
  // averaged separately per category on Gym (see gymService aggregate calls).
  equipmentRating      Float?
  cleanlinessRating    Float?
  trainerRating        Float?
  valueForMoneyRating  Float?
  staffBehaviourRating Float?
  crowdRating          Float?
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([gymId, customerId])
  @@schema("gym")
}

model SlotBlock {
  id        Int      @id @default(autoincrement())
  gymId     Int
  date      String
  startTime String
  endTime   String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([gymId, date])
  @@schema("gym")
}

// Price for a time-of-day slot (e.g. "18:00"-"19:00"), the same every day of
// the week. One row per distinct startTime that generateTimeSlots() produces
// for this gym; a slot with no row here falls back to Gym.sessionPrice.
model GymSlotPrice {
  id        Int      @id @default(autoincrement())
  gymId     Int
  startTime String
  endTime   String
  price     Decimal  @db.Decimal(19, 2)
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, startTime])
  @@index([gymId])
  @@schema("gym")
}

// Per-day-of-week operating hours, up to two windows/day (morning + evening,
// null = no window that day — i.e. either a closed midday gap between them,
// or the whole day closed if both are null). Every existing gym is backfilled
// with 7 rows reproducing its old single openTime/closeTime window exactly
// (see the migration for this model) so nothing changes until a partner
// edits their hours. Gym.openTime/closeTime/slotDuration are left in place
// but only slotDuration is still read by slot generation post-migration.
model GymOperatingHours {
  id           Int      @id @default(autoincrement())
  gymId        Int
  dayOfWeek    Int // 0=Sunday..6=Saturday
  morningStart String?
  morningEnd   String?
  eveningStart String?
  eveningEnd   String?
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([gymId, dayOfWeek])
  @@schema("gym")
}

// A recurring bookable class (e.g. "Yoga", Mon/Wed/Fri 7-8am) — a class held
// multiple times a week is multiple rows, one per dayOfWeek. Has its own
// capacity pool, separate from the gym's plain-slot capacity (see
// booking-service's Booking.classId). price null = included with an active
// subscription at this gym (same daily quota as a regular session); price
// set = always charged that amount regardless of subscription status.
model GymClass {
  id            Int                    @id @default(autoincrement())
  gymId         Int
  name          String
  description   String?
  instructor    String?
  dayOfWeek     Int
  startTime     String
  endTime       String
  capacity      Int
  price         Decimal?               @db.Decimal(19, 2)
  isActive      Boolean                @default(true)
  gym           Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  cancellations GymClassCancellation[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([gymId, dayOfWeek])
  @@schema("gym")
}

// One-off cancellation of a single occurrence of a recurring GymClass (e.g.
// instructor sick on a specific date) — mirrors SlotBlock's per-date
// mechanism for plain slots, but scoped to a class instead of a startTime.
model GymClassCancellation {
  id        Int      @id @default(autoincrement())
  classId   Int
  date      String
  class     GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, date])
  @@schema("gym")
}

enum EditRequestType {
  profile
  image_add
  image_delete
  doc_add
  doc_delete
  slot_prices
  slot_block_add
  slot_block_delete
  operating_hours_update
  class_add
  class_update
  class_delete

  @@schema("gym")
}

enum EditRequestStatus {
  pending
  approved
  rejected
  // The submitting partner cancelled it themselves before a gobhi reviewed
  // it — distinct from `rejected` (a gobhi disapproving it) so
  // PendingEditBanner-style "your change was not approved" messaging never
  // fires for something the partner withdrew on their own.
  withdrawn

  @@schema("gym")
}

// A partner mutation on an already-approved (live) gym. Instead of writing
// straight to Gym/GymImage/SlotBlock/GymSlotPrice, the proposed change sits
// here until a gobhi approves it — customers keep seeing the old approved
// data the whole time. Gyms that have never been approved yet skip this
// entirely (see gymService.js's isApproved gate) since nothing is live to
// protect.
model GymEditRequest {
  id              Int                @id @default(autoincrement())
  gymId           Int
  gym             Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  partnerId       Int
  changeType      EditRequestType
  payload         Json
  status          EditRequestStatus  @default(pending)
  rejectionReason String?
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([gymId, status])
  @@index([status])
  @@schema("gym")
}
