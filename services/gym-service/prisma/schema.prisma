generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["gym"]
}

model Gym {
  id           Int         @id @default(autoincrement())
  partnerId    Int
  name         String
  description  String?
  address      String
  city         String
  state        String
  lat          Float
  lng          Float
  amenities    String[]
  phone        String
  sessionPrice Float
  quotedPrice  Float?
  established  Int?
  brandDocs    String[]
  openTime     String
  closeTime    String
  slotDuration Int         @default(60)
  capacity     Int         @default(20)
  rating       Float       @default(0)
  ratingCount  Int         @default(0)
  isApproved   Boolean     @default(false)
  rejectionReason String?
  isActive     Boolean     @default(true)
  weeklyPlanPrice    Float?
  monthlyPlanPrice   Float?
  quarterlyPlanPrice Float?
  yearlyPlanPrice    Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  images       GymImage[]
  reviews      GymReview[]
  slotBlocks   SlotBlock[]
  slotPrices   GymSlotPrice[]

  @@index([partnerId])
  @@schema("gym")
}

model GymImage {
  id        Int      @id @default(autoincrement())
  gymId     Int
  url       String
  publicId  String?
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@schema("gym")
}

model GymReview {
  id         Int      @id @default(autoincrement())
  gymId      Int
  customerId Int
  rating     Float
  comment    String?
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([gymId, customerId])
  @@schema("gym")
}

model SlotBlock {
  id        Int      @id @default(autoincrement())
  gymId     Int
  date      String
  startTime String
  endTime   String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([gymId, date])
  @@schema("gym")
}

// Price for a time-of-day slot (e.g. "18:00"-"19:00"), the same every day of
// the week. One row per distinct startTime that generateTimeSlots() produces
// for this gym; a slot with no row here falls back to Gym.sessionPrice.
model GymSlotPrice {
  id        Int      @id @default(autoincrement())
  gymId     Int
  startTime String
  endTime   String
  price     Float
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gymId, startTime])
  @@index([gymId])
  @@schema("gym")
}
