# Environment Variables Reference for Phool Gobhi Backend
#
# Deployed on GCP Cloud Run, single project `phool-gobhi` (region asia-south1).
# Both dev and prod live in that one project, distinguished by service-name
# suffix (<service>-dev / <service>-prod) — set these via
# `gcloud run services update <service>-dev --set-env-vars ...` or the Cloud
# Run console, not a committed .env file. Do NOT commit real secrets here.
#
# Deploys go through the /deploy slash command (.claude/commands/deploy.md),
# which resolves the correct suffixed service name per env.

# ============================================================================
# GATEWAY (gateway-dev / gateway-prod) - Port 5000
# ============================================================================

# JWT secret for verifying tokens (minimum 64-char hex string)
# Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_64_char_hex_string_here_minimum_length

# Downstream service URLs — Cloud Run HTTPS URLs for the matching env
# (e.g. https://auth-service-dev-xxxxx.asia-south1.run.app)
AUTH_SERVICE_URL=https://auth-service-dev-xxxxx.asia-south1.run.app
WALLET_SERVICE_URL=https://wallet-service-dev-xxxxx.asia-south1.run.app
GYM_SERVICE_URL=https://gym-service-dev-xxxxx.asia-south1.run.app
BOOKING_SERVICE_URL=https://booking-service-dev-xxxxx.asia-south1.run.app
BUDDY_SERVICE_URL=https://buddy-service-dev-xxxxx.asia-south1.run.app

# Shared secret guarding service-to-service internal endpoints (wallet
# credit/debit, internal user/gym lookups, buddy profile-sync, etc). Must be
# IDENTICAL across every service. The gateway strips any client-supplied
# x-internal-key, so external callers can never satisfy it.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Analytics / funnels (see docs/ANALYTICS.md). Set on EVERY service + gateway.
#   ANALYTICS_PROVIDER: 'none' (default, no-op) | 'console' (logs events) |
#     'postgres' (first-party sink, active on dev) | 'posthog' (HTTP capture)
# Dev tip: set ANALYTICS_PROVIDER=console to watch events in service logs
# without needing a DB.
ANALYTICS_PROVIDER=console
ANALYTICS_DATABASE_URL=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Identifies the emitting service in event properties — set per service:
# gateway | auth-service | booking-service | wallet-service | gym-service | buddy-service
ANALYTICS_SERVICE_NAME=gateway

# ============================================================================
# AUTH SERVICE (auth-service-dev / auth-service-prod) - Port 5001
# ============================================================================

# PostgreSQL connection string (Neon, or whatever Cloud SQL/Postgres host is
# current post-migration — confirm before relying on this).
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_auth?sslmode=require

# JWT secrets for token generation and refresh
# Generate each: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_64_char_hex_string_here_minimum_length
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_char_hex_string_here_minimum_length

# Fast2SMS API for OTP delivery
# Get from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# WhatsApp Business API credentials (for OTP delivery via WhatsApp)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=your_whatsapp_template_name_here

# Which OTP provider clients should use: 'fast2sms' (default) or 'firebase'.
# Read by GET /api/auth/otp-config. See docs/otp-application.md.
OTP_PROVIDER=fast2sms

# auth-service's own Firebase Admin credential, for verifying Firebase Phone
# Auth ID tokens (POST /verify-firebase-token).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"phool-gobhi-customer-dev","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your_firebase_email@appspot.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url"}

# DEV ONLY — never set on *-prod. When 'true': send-otp echoes the OTP in the
# response and verify-otp accepts the universal test OTP 123456.
ALLOW_DEV_OTP=true

# gym-service base URL — auth-service calls it on partner login to include an
# onboarding summary (hasGym/approved) in the verify-otp response.
GYM_SERVICE_URL=https://gym-service-dev-xxxxx.asia-south1.run.app

# buddy-service base URL — fire-and-forget call to keep buddy-service's
# denormalized profile cache (gender/DOB/fitnessGoals) in sync after a
# profile edit (see controllers/userProfileController.js).
BUDDY_SERVICE_URL=https://buddy-service-dev-xxxxx.asia-south1.run.app

INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here
ANALYTICS_PROVIDER=console
ANALYTICS_SERVICE_NAME=auth-service

# ============================================================================
# WALLET SERVICE (wallet-service-dev / wallet-service-prod) - Port 5003
# ============================================================================

DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_wallet?sslmode=require

# Razorpay API credentials (for payment processing)
# Get from: https://razorpay.com/ (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_SECRET=rzp_test_your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here
ANALYTICS_PROVIDER=console
ANALYTICS_SERVICE_NAME=wallet-service

# ============================================================================
# GYM SERVICE (gym-service-dev / gym-service-prod) - Port 5004
# ============================================================================

DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_gym?sslmode=require

# Booking service URL — gym-service calls it to compute real slot availability
BOOKING_SERVICE_URL=https://booking-service-dev-xxxxx.asia-south1.run.app

INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Cloudinary credentials (for gym image/doc uploads)
# Get from: https://cloudinary.com/console/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

ANALYTICS_PROVIDER=console
ANALYTICS_SERVICE_NAME=gym-service

# ============================================================================
# BOOKING SERVICE (booking-service-dev / booking-service-prod) - Port 5005
# ============================================================================

DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_booking?sslmode=require

WALLET_SERVICE_URL=https://wallet-service-dev-xxxxx.asia-south1.run.app
GYM_SERVICE_URL=https://gym-service-dev-xxxxx.asia-south1.run.app

# Same shared secret as wallet-service (booking-service signs credit/debit calls with it)
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Firebase service account (for push notifications/messaging)
# Download JSON from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Convert to single-line string: cat serviceAccountKey.json | jq -c . | xargs echo
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project_id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your_firebase_email@appspot.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url"}

ANALYTICS_PROVIDER=console
ANALYTICS_SERVICE_NAME=booking-service

# ============================================================================
# BUDDY SERVICE (buddy-service-dev / buddy-service-prod) - Port 5007
# ============================================================================

DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_buddy?sslmode=require

# auth-service base URL — buddy-service resolves display fields via
# /internal/:id and /internal/users/batch.
AUTH_SERVICE_URL=https://auth-service-dev-xxxxx.asia-south1.run.app

INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Cloudinary credentials (for buddy profile photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Firebase service account (chat/new-match push notifications)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project_id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your_firebase_email@appspot.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url"}

ANALYTICS_PROVIDER=console
ANALYTICS_SERVICE_NAME=buddy-service

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# 1. Database (Neon Postgres, or current Cloud SQL host post-migration):
#    - Each service uses its own physically separate database
#      (phool_gobhi_auth / _wallet / _gym / _booking / _buddy), additionally
#      namespaced internally via Prisma's multiSchema feature.
#
# 2. Deploying:
#    - Use the /deploy <service> <dev|prod> slash command — it resolves the
#      correct <service>-dev/<service>-prod Cloud Run service name, guards
#      known footguns (e.g. gym-service's /health route-order issue), and
#      health-checks after deploy. There is no CI/CD trigger — deploys are
#      manual via /deploy only.
#
# 3. Setting env vars:
#    - `gcloud run services update <service>-<env> --set-env-vars KEY=VALUE`
#      or via the Cloud Run console. Never commit real secrets to this file.
#
# 4. Local development (docker-compose):
#    - `docker-compose up` runs everything against a local Postgres
#      container with per-service databases (see init-db.sql) — no Cloud Run
#      / Neon / Cloud SQL involved. Inter-service URLs there use Docker
#      network hostnames (http://auth-service:5001, etc), not the HTTPS URLs
#      above.
#
# 5. Secrets Management:
#    - Rotate sensitive keys periodically.
#    - INTERNAL_API_KEY must be byte-identical across every service — a
#      trailing newline from a Secret Manager copy/paste is a known past
#      footgun (all internal-key comparisons now `.trim()` defensively).
