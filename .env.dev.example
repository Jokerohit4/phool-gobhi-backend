# Environment Variables Reference for Phool Gobhi Backend (Render + Neon + MongoDB Atlas)
#
# This file is for reference only. Set these values in the Render dashboard under
# each service's Environment tab. Do NOT commit real secrets to this file.
#
# After deploying services on Render, update the service URLs below with actual Render URLs.

# ============================================================================
# GATEWAY SERVICE (pg-gateway) - Port 5000
# ============================================================================

# JWT secret for signing tokens (minimum 64-char hex string)
# Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_64_char_hex_string_here_minimum_length

# Analytics / funnels (see docs/ANALYTICS.md). Set on EVERY service.
#   ANALYTICS_PROVIDER: 'none' (default, no-op) | 'console' (logs events) | 'posthog'
#   For PostHog (free tier) also set POSTHOG_API_KEY (+ optional POSTHOG_HOST).
# Dev tip: set ANALYTICS_PROVIDER=console to watch events in service logs.
ANALYTICS_PROVIDER=console
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Identifies the emitting service in event properties (set per service):
# auth-service | booking-service | wallet-service | gym-service
ANALYTICS_SERVICE_NAME=auth-service

# Shared secret guarding service-to-service wallet mutations (credit/debit).
# Must be IDENTICAL across wallet-service and booking-service. The gateway strips any
# client-supplied x-internal-key, so external callers can never satisfy it.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Service endpoints - update these after deploying each service on Render
AUTH_SERVICE_URL=https://pg-auth-service.onrender.com
USER_SERVICE_URL=https://pg-user-service.onrender.com
WALLET_SERVICE_URL=https://pg-wallet-service.onrender.com
GYM_SERVICE_URL=https://pg-gym-service.onrender.com
BOOKING_SERVICE_URL=https://pg-booking-service.onrender.com

# ============================================================================
# AUTH SERVICE (pg-auth-service) - Port 5001
# ============================================================================

# PostgreSQL connection string (from Neon)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_auth?sslmode=require

# JWT secrets for token generation and refresh
# Generate each: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_64_char_hex_string_here_minimum_length
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_char_hex_string_here_minimum_length

# Fast2SMS API for OTP delivery
# Get from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# WhatsApp Business API credentials (for OTP delivery via WhatsApp)
# Get from: https://www.twilio.com/en-us/messaging/channels/whatsapp or Facebook Business
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=your_whatsapp_template_name_here

# DEV ONLY — never set in production. When 'true': send-otp echoes the OTP in the
# response and verify-otp accepts the universal test OTP 123456.
ALLOW_DEV_OTP=true

# gym-service base URL — auth-service calls it on partner login to include an
# onboarding summary (hasGym/approved) in the verify-otp response so the app can
# route to the dashboard vs. onboarding from the server's source of truth.
GYM_SERVICE_URL=https://pg-gym-service.onrender.com

# Same shared secret as the other services (auth-service signs the internal
# gym-summary lookup with it). Required for the onboarding routing above to work.
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# ============================================================================
# USER SERVICE (pg-user-service) - Port 5002
# ============================================================================

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://phool_gobhi_user:your_mongodb_password_here@phool-gobhi-cluster.mongodb.net/phool_gobhi_users?retryWrites=true&w=majority

# ============================================================================
# WALLET SERVICE (pg-wallet-service) - Port 5003
# ============================================================================

# PostgreSQL connection string (from Neon)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_wallet?sslmode=require

# Razorpay API credentials (for payment processing)
# Get from: https://razorpay.com/ (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_SECRET=rzp_test_your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Same shared secret as the gateway/booking-service (see INTERNAL_API_KEY above)
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# ============================================================================
# GYM SERVICE (pg-gym-service) - Port 5004
# ============================================================================

# PostgreSQL connection string (from Neon)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_gym?sslmode=require

# Booking service URL — gym-service calls it to compute real slot availability
BOOKING_SERVICE_URL=https://pg-booking-service.onrender.com

# Shared secret guarding gym-service's internal endpoints (e.g. the partner
# onboarding summary auth-service reads at login). Must match the value used by
# the other services.
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Cloudinary credentials (for image uploads)
# Get from: https://cloudinary.com/console/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ============================================================================
# BOOKING SERVICE (pg-booking-service) - Port 5005
# ============================================================================

# PostgreSQL connection string (from Neon)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neon_user:neon_password@ep-cool-tree-a1b2c3d4.us-east-1.aws.neon.tech/phool_gobhi_booking?sslmode=require

# Service endpoints - update these after deploying each service on Render
WALLET_SERVICE_URL=https://pg-wallet-service.onrender.com
GYM_SERVICE_URL=https://pg-gym-service.onrender.com
USER_SERVICE_URL=https://pg-user-service.onrender.com

# Same shared secret as wallet-service (booking-service signs credit/debit calls with it)
INTERNAL_API_KEY=your_internal_api_key_64_char_hex_string_here

# Firebase service account (for push notifications/messaging)
# Download JSON from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Convert to single-line string: cat serviceAccountKey.json | jq -c . | xargs echo
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_firebase_project_id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your_firebase_email@appspot.gserviceaccount.com","client_id":"your_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your_cert_url"}

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# 1. Database Setup (Neon PostgreSQL):
#    - Sign up at https://neon.tech/
#    - Create a project and get the connection string
#    - Each service can use a separate database or share one with different schemas
#
# 2. MongoDB Setup (Atlas):
#    - Sign up at https://www.mongodb.com/cloud/atlas
#    - Create a cluster on free tier
#    - Get connection string from Connect dialog
#    - Allowlist Render IP addresses in Network Access tab
#
# 3. Render Deployment:
#    - Connect your GitHub repo to Render
#    - Create 6 web services using render.yaml blueprint
#    - Set environment variables in Render dashboard (do not use .env file)
#    - Services will auto-deploy on git push
#
# 4. Service URLs:
#    - After deployment, each service gets a URL: https://pg-SERVICE-NAME.onrender.com
#    - Update inter-service communication URLs in the dashboard
#
# 5. Free Tier Limitations:
#    - Services spin down after 15 minutes of inactivity
#    - First request after spindown takes ~30 seconds
#    - To keep services running, consider upgrading or using pings
#
# 6. Secrets Management:
#    - Never commit .env files with real secrets
#    - Use Render's encrypted environment variables
#    - Rotate sensitive keys periodically
